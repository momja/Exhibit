{{/* Gallery index (library) page. Data: galleryPageData (gallery.go). */}}
{{define "gallery"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1{{if .Spaces}},viewport-fit=cover{{end}}">
<title>{{if .Grid.Title}}{{.Grid.Title}} · {{end}}Exhibit</title>
<link rel="icon" type="image/svg+xml" href="{{.Favicon}}">
{{template "pwaHead"}}
{{template "clerkScripts" .Clerk}}
<link rel="stylesheet" href="{{asset "phosphor/regular.css"}}">
<link rel="stylesheet" href="{{asset "gallery/tokens.css"}}">
<link rel="stylesheet" href="{{asset "gallery/components.css"}}">
<link rel="stylesheet" href="{{asset "gallery/index.css"}}">
</head>
<body>
<div id="gallery-shell" data-gallery data-controller="gallery filter-sheet scroll-chrome">
{{template "appHeader" .Header}}
<p class="gallery-error" data-gallery-navigation-error role="alert" hidden>Couldn’t open that page. Try again.</p>
{{template "gallerySpaceContent" .}}
</div>

{{/* No CodeMirror island here: the only editor on this page was the ingest
     form's source field, which moved to /new with it. */}}
<script>
const TOKEN = {{.Token}};
{{/* READ_ONLY and TOKEN are one decision, made server-side per request
     (av-5imk, pagecredential.go): a session-authenticated browser gets no
     token because its cookie already authenticates it, an anonymous visitor
     gets no token and READ_ONLY, and a single-user instance with no identity
     provider gets the static token it has always had. api.js is what spends
     the result — page scripts never build an Authorization header. Literal
     template text for the boolean, matching the other bootstrap flags:
     html/template's JS escaper pads a {{value}} boolean with spaces. */ -}}
{{/* Gallery space switches carry the live ReadOnly decision on gallerySpaceContent.
     api.js reads it at call time; TOKEN stays valid for this same visitor. */}}
const READ_ONLY = {{if .ReadOnly}}true{{else}}false{{end}};
</script>
<script src="{{asset "gallery/api.js"}}"></script>
<script src="{{asset "gallery/components.js"}}"></script>
<script src="{{asset "htmx/htmx.min.js"}}"></script>
{{template "componentScripts"}}
<script type="module" src="{{asset "gallery/index.js"}}"></script>
</body>
</html>{{end}}

{{/* These regions have one definition for full loads, space switches and
     history restoration. The header and its Clerk controller never swap. */}}
{{define "gallerySearchRegion"}}<div id="gallery-search-region">{{template "gallerySearchControls" .}}</div>{{end}}
{{define "gallerySearchControls"}}
  <h1 class="app-header-title sr-only">{{if .Title}}{{.Title}}{{else}}Gallery{{end}}</h1>
  {{template "galleryHeaderSearch" .}}
{{end}}

{{define "gallerySpaceContent"}}<div id="gallery-content" hx-history-elt data-gallery-target="space" data-gallery-read-only="{{if .ReadOnly}}true{{else}}false{{end}}" data-controller="gallery-space artifact-stars">
<div id="{{.Grid.ID}}">
{{if or .Spaces .Grid.Filters.Sections}}<div class="gallery-layout{{if not .Spaces}} gallery-layout-solo{{end}}">{{template "gallerySpaces" .}}{{end -}}
<main>{{if .Grid.Title}}<h2 class="gallery-title">{{.Grid.Title}}</h2>{{end}}
{{if .Grid.Description}}<p class="gallery-description">{{.Grid.Description}}</p>{{end}}
{{if .Grid.HideSearch}}{{if not .Grid.Activity}}<div hidden>{{template "gallerySearch" .Grid}}</div>{{end}}{{end}}
{{if .Grid.SearchPage}}<div class="gallery-page-search">{{template "gallerySearch" .Grid}}</div>{{end}}
{{/* Cards share their tile, title, status marks, and action menu with every
     gallery fragment. Card clicks open the viewer; menu actions have their
     own controls and are handled through delegation after htmx swaps. */}}
<p class="gallery-error" data-gallery-action-error role="alert" hidden>Couldn’t update your starred artifacts. Please try again.</p>
{{if .Grid.Activity}}{{template "activityOverview" .Grid}}{{end}}
{{template "galleryResults" .Grid}}
</main>
{{- if or .Spaces .Grid.Filters.Sections}}</div>{{end}}{{if .Grid.Filters.Sections}}
{{template "galleryFilterSheet" .Grid}}{{end}}
{{if not .ReadOnly}}{{template "duplicateDialog" .Grid}}{{end}}
</div>
</div>{{end}}

{{define "gallerySpaceUpdate"}}<title>{{if .Grid.Title}}{{.Grid.Title}} · {{end}}Exhibit</title>
{{template "gallerySpaceContent" .}}
<div hx-swap-oob="outerHTML:#gallery-search-region" id="gallery-search-region">{{template "gallerySearchControls" .Grid}}</div>
{{end}}

{{define "galleryHeaderSearch"}}
  {{/* Search owns a page-level form at every width. Other searchable
       destinations may reuse the compact header form. Starred and Activity
       expose neither a search field nor filters. */}}
  {{if and (not .SearchPage) (not .HideSearch)}}{{template "gallerySearch" .}}{{end}}{{if .Filters.Sections}}
  <button class="btn btn-sec gallery-filter-trigger" type="button" data-filter-sheet-target="trigger" data-action="filter-sheet#open" aria-controls="{{.ID}}-filter-sheet" aria-haspopup="dialog"><i class="ph ph-sliders" aria-hidden="true"></i><span>Filter</span></button>{{end}}
{{end}}
