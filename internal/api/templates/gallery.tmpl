{{/* Gallery index (library) page. Data: galleryPageData (gallery.go). */}}
{{define "gallery"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Exhibit</title>
<link rel="icon" type="image/svg+xml" href="{{.Favicon}}">
{{template "pwaHead"}}
<link rel="stylesheet" href="/assets/phosphor/regular.css">
<link rel="stylesheet" href="/assets/gallery/tokens.css">
<link rel="stylesheet" href="/assets/gallery/components.css">
<link rel="stylesheet" href="/assets/gallery/index.css">
</head>
<body>
<header>
  {{.LogoSVG}}
  <h1>Exhibit</h1>
  <span class="spacer"></span>
  {{/* Ingest moved to its own page (av-qo0j), so the library's single
       creation affordance is this primary button. The agent link it replaced
       isn't lost — the agent is the third creation route on /new, which is
       where creation now lives. */}}
  <a class="btn" href="/new"><i class="ph ph-plus"></i> Add artifact</a>
</header>
<main>
{{/* Search leads the page: with the upload card gone, the library opens on
     the control you use to find things in it rather than below the fold. */}}
<div class="search-row">
  <i class="ph ph-magnifying-glass search-icon" aria-hidden="true"></i>
  <input type="text" id="search-input" name="q" placeholder="Search artifacts…" value="{{.Query}}" autocomplete="off">
  <button class="btn btn-sm search-clear" type="button" id="search-clear" aria-label="Clear search" hidden><i class="ph ph-x"></i></button>
</div>

{{/* The whole card opens the artifact's detail/viewer page — the card body
     and the title link are the affordances. The separate 'Details' link was
     removed: it navigated to the same page as the title click, so it was
     redundant. The earlier 'Open ↗' new-tab action was already gone.

     The one card action that is NOT the detail page — Edit — rides in the
     title row as a hover/focus-revealed chip (av-8u7p). It sits beside the
     title rather than over it so the two links' hit boxes never overlap, and
     it carries a visible 'Edit' label: a bare pencil is reachable by voice
     control through its accessible name, but that name is undiscoverable
     when nothing on screen states it. The aria-label leads with that same
     word, so the visible label is a prefix of the accessible name (WCAG
     2.5.3) while the name still says which artifact it edits. */}}
<div class="grid">{{if not .Cards}}<p class="empty">No artifacts yet. <a href="/new">Add your first artifact</a>.</p>{{end}}{{range .Cards}}
<div class="card" data-href="/artifacts/{{.ArtifactID}}">
  <div class="card-headrow"><a class="card-title" href="/artifacts/{{.ArtifactID}}">{{.Title}}</a><a class="card-edit" href="/artifacts/{{.ArtifactID}}/edit" aria-label="Edit {{.Title}}"><i class="ph ph-pencil-simple"></i>Edit</a></div>
  {{template "tagRow" .}}
  <div class="card-footer">
    <div class="card-meta">{{.Created}}</div>
    {{template "capabilityCluster" .Capability}}
  </div>
</div>{{end}}</div>
</main>

{{template "editTagModal" .Presets}}
{{template "addTagModal" .AddTagModal}}

{{/* No CodeMirror island here: the only editor on this page was the ingest
     form's source field, which moved to /new with it. */}}
<script>
const TOKEN = {{.Token}};
const DEFAULT_TAG_COLOR = {{.DefaultTagColor}};
</script>
<script src="/assets/gallery/components.js"></script>
<script src="/assets/gallery/index.js"></script>
</body>
</html>{{end}}
