{{/* Gallery index (library) page. Data: galleryPageData (gallery.go). */}}
{{define "gallery"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Exhibit</title>
<link rel="icon" type="image/svg+xml" href="{{.Favicon}}">
{{template "pwaHead"}}
<link rel="stylesheet" href="/assets/phosphor/regular.css">
<link rel="stylesheet" href="/assets/gallery/tokens.css">
<link rel="stylesheet" href="/assets/gallery/components.css">
<link rel="stylesheet" href="/assets/gallery/index.css">
</head>
<body>
<header>
  {{.LogoSVG}}
  {{/* The gallery's heading, hidden visually (index.css) but kept so the page
       still has an h1 to navigate by. A visible "Exhibit" beside the logo
       named the product, not the page (nw-h1dr). */}}
  <h1>Gallery</h1>
  {{/* Search sits in the app bar beside the logo (av-uvc6) rather than in a
       row of its own above the grid: the library opens on the control you
       use to find things in it, and the grid gets the height back.

       `/` focuses it from anywhere on the page (av-6mdw, index.js). The key cap
       after the input is how a sighted user learns that; aria-keyshortcuts is
       how a screen reader does, so the cap itself is aria-hidden. It must stay
       the input's later sibling: index.css hides it with `input:focus ~` and
       `input:not(:placeholder-shown) ~`, so it disappears once the box is in
       use with no script involved. */}}
  <div class="search-row" role="search">
    <i class="ph ph-magnifying-glass search-icon" aria-hidden="true"></i>
    <input type="text" id="search-input" name="q" placeholder="Search artifacts…" value="{{.Query}}" autocomplete="off" aria-label="Search artifacts" aria-keyshortcuts="/">
    <kbd class="search-kbd" aria-hidden="true">/</kbd>
    <button class="search-clear" type="button" id="search-clear" aria-label="Clear search" hidden><i class="ph ph-x" aria-hidden="true"></i></button>
  </div>
  <span class="spacer"></span>
  {{/* Administration is a secondary control, and it appears only for an
       admin (av-utap). The hiding is a courtesy to everyone else, not a
       control: /admin/users carries its own adminOnly guard, so a visitor who
       types the URL is refused there rather than admitted by a template that
       forgot to hide a link.

       It keeps its label while the two controls after it lose theirs. Being
       conditional and rare is exactly why: collapsing it to a third anonymous
       glyph would leave a row of icons that says nothing. The one exception
       is a phone, where the header also holds search (av-uvc6) and the label
       would crush the box to a few letters: there the word is hidden visually
       but stays the link's name, and the title says it on hover. */}}
  {{if .IsAdmin}}<a class="btn btn-sec" href="/admin/users" title="Accounts"><i class="ph ph-users-three" aria-hidden="true"></i><span class="header-link-label">Accounts</span></a>{{end}}
  {{/* Two icon-only peers (av-qo05) — same box, same weight, so neither reads
       as the "real" one. The header's subject is the library below it, and a
       wide primary button made the header the loudest thing on a page it is
       not about. Add artifact is still the library's one creation route —
       ingest lives at /new (av-qo0j), the agent included — it just stops
       shouting.

       Dropping the visible label costs discoverability, so each carries an
       aria-label (the accessible name, for screen readers and voice control)
       and a title (the pointer tooltip, for everyone else). The empty-library
       state below still spells the affordance out in words, which is where
       someone arriving with nothing on the shelf learns it. */}}
  <a class="btn btn-sec icon-btn" href="/new" aria-label="Add artifact" title="Add artifact"><i class="ph ph-plus" aria-hidden="true"></i></a>
  {{/* Static means static: an anchor to a page, no menu and no JS. What
       belongs on that page — deletion, the agent key, active sessions — each
       needs explanation or a confirmation beside it, and none of that fits a
       menu item. */}}
  <a class="btn btn-sec icon-btn" href="/profile" aria-label="Your account" title="Your account"><i class="ph ph-user-circle" aria-hidden="true"></i></a>
</header>
<main>
{{/* One card is the tile plus a single meta row (av-uvc6): title, tag dots,
     the posture and sharing glyphs, and Edit. No created date and no
     "Sandboxed" label; a sandboxed, private artifact carries no marks at all.

     The whole card opens the artifact's detail/viewer page — the card body
     and the title link are the affordances (index.js).

     The one card action that is NOT the detail page — Edit — is a pencil at
     the row's end, revealed on hover or focus (av-8u7p, av-uvc6). It stays in
     the accessibility tree while hidden, so a screen reader listing links
     still finds it, and its accessible name leads with "Edit" and names the
     artifact; the title attribute is the word a pointer user sees. */}}
<div class="grid">{{if not .Cards}}<p class="empty">No artifacts yet. <a href="/new">Add your first artifact</a>.</p>{{end}}{{range .Cards}}
<div class="card" data-href="/artifacts/{{.ArtifactID}}">
  {{template "cardWidget" .Widget}}
  <div class="card-meta"><a class="card-title" href="/artifacts/{{.ArtifactID}}">{{.Title}}</a>{{template "tagDots" .}}{{template "capabilityCluster" .Capability}}<a class="card-edit" href="/artifacts/{{.ArtifactID}}/edit" aria-label="Edit {{.Title}}" title="Edit"><i class="ph ph-pencil-simple" aria-hidden="true"></i></a></div>
</div>{{end}}</div>
</main>

{{/* No CodeMirror island here: the only editor on this page was the ingest
     form's source field, which moved to /new with it. */}}
<script>
const TOKEN = {{.Token}};
{{/* READ_ONLY and TOKEN are one decision, made server-side per request
     (av-5imk, pagecredential.go): a session-authenticated browser gets no
     token because its cookie already authenticates it, an anonymous visitor
     gets no token and READ_ONLY, and a single-user instance with no identity
     provider gets the static token it has always had. api.js is what spends
     the result — page scripts never build an Authorization header. Literal
     template text for the boolean, matching the other bootstrap flags:
     html/template's JS escaper pads a {{value}} boolean with spaces. */ -}}
const READ_ONLY = {{if .ReadOnly}}true{{else}}false{{end}};
</script>
<script src="/assets/gallery/api.js"></script>
<script src="/assets/gallery/components.js"></script>
<script src="/assets/gallery/index.js"></script>
</body>
</html>{{end}}
