{{/* Login page (av-q30x). Data: loginPageData (gallery.go).

     Where an unauthenticated visitor lands once an instance has a login. It is
     rendered only when a local credential is configured — with an identity
     provider alone the gate redirects straight to the provider, because a page
     whose only control is "continue" is a choice that does not exist.

     Deliberately scriptless: no bootstrap block, no /assets/gallery/*.js. The
     form posts itself, and this is the one page in the app that must work for
     somebody who is not yet allowed to load anything else.

     Username and Error are echoed back through html/template's contextual
     escaping — Username is whatever was typed into the form, so it is
     attacker-controlled text and must never be assembled into markup. */}}
{{/* The painted front door (Exh-90b2). One scene, shared by every sign-in page.

     .login-scene is a fixed, pointer-less stage; .login-scene-composite is the
     static final frame that paints first. Data: whether this visit plays the
     descent (Exh-vsw0). If so, the sky, cloud and hill layers are emitted as
     empty divs (their images are CSS backgrounds in login-descent.css, so a
     visit that does not animate downloads none of them) and the composite is
     hidden until they settle on top of it. Only .login-scene ever moves;
     .login-content never does.

     Only the active colour mode and one width download: sources match in order,
     so the first matching media query and a supported type win. Light is the
     default, dusk follows prefers-color-scheme: dark, phones get the portrait
     crop. Explicit dimensions keep the stage from shifting layout. */}}
{{define "loginScene"}}<div class="login-scene" aria-hidden="true">
  <picture class="login-scene-composite">
    <source media="(max-width:600px) and (prefers-color-scheme:dark)" type="image/avif" srcset="{{asset "hero-art/dusk-phone-750.avif"}} 750w, {{asset "hero-art/dusk-phone-1170.avif"}} 1170w" sizes="100vw" width="1170" height="2535">
    <source media="(max-width:600px) and (prefers-color-scheme:dark)" type="image/webp" srcset="{{asset "hero-art/dusk-phone-750.webp"}} 750w, {{asset "hero-art/dusk-phone-1170.webp"}} 1170w" sizes="100vw" width="1170" height="2535">
    <source media="(max-width:600px)" type="image/avif" srcset="{{asset "hero-art/day-phone-750.avif"}} 750w, {{asset "hero-art/day-phone-1170.avif"}} 1170w" sizes="100vw" width="1170" height="2535">
    <source media="(max-width:600px)" type="image/webp" srcset="{{asset "hero-art/day-phone-750.webp"}} 750w, {{asset "hero-art/day-phone-1170.webp"}} 1170w" sizes="100vw" width="1170" height="2535">
    <source media="(prefers-color-scheme:dark)" type="image/avif" srcset="{{asset "hero-art/dusk-composite-960.avif"}} 960w, {{asset "hero-art/dusk-composite-1600.avif"}} 1600w, {{asset "hero-art/dusk-composite-2560.avif"}} 2560w" sizes="max(100vw, 177.8vh)" width="2560" height="1440">
    <source media="(prefers-color-scheme:dark)" type="image/webp" srcset="{{asset "hero-art/dusk-composite-960.webp"}} 960w, {{asset "hero-art/dusk-composite-1600.webp"}} 1600w, {{asset "hero-art/dusk-composite-2560.webp"}} 2560w" sizes="max(100vw, 177.8vh)" width="2560" height="1440">
    <source type="image/avif" srcset="{{asset "hero-art/day-composite-960.avif"}} 960w, {{asset "hero-art/day-composite-1600.avif"}} 1600w, {{asset "hero-art/day-composite-2560.avif"}} 2560w" sizes="max(100vw, 177.8vh)" width="2560" height="1440">
    <source type="image/webp" srcset="{{asset "hero-art/day-composite-960.webp"}} 960w, {{asset "hero-art/day-composite-1600.webp"}} 1600w, {{asset "hero-art/day-composite-2560.webp"}} 2560w" sizes="max(100vw, 177.8vh)" width="2560" height="1440">
    <img class="login-scene-image" src="{{asset "hero-art/day-composite-1600.webp"}}" alt="" width="2560" height="1440" decoding="async" fetchpriority="high">
  </picture>
  {{if .}}<div class="login-layers"><div class="login-layers-stage"><div class="login-layer login-layer-sky"></div><div class="login-layer login-layer-clouds"></div><div class="login-layer login-layer-hill"></div></div></div>{{end}}
  <div class="login-scene-grain grain"></div>
</div>{{end}}

{{/* Headline and tagline, over the painting. Copy overlaps Exh-s7kn's onboarding
     copy; see the note on Exh-90b2. */}}
{{define "loginIntro"}}<div class="login-intro">
  <p class="login-headline font-headline">A shelf for <em>small</em> tools.</p>
  <p class="login-tagline">Saved as files, rendered anywhere, yours to keep.</p>
</div>{{end}}

{{define "login"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sign in — Exhibit</title>
<link rel="icon" type="image/svg+xml" href="{{.Favicon}}">
{{template "pwaHead"}}
{{template "fontsHead"}}
<link rel="stylesheet" href="{{asset "phosphor/regular.css"}}">
<link rel="stylesheet" href="{{asset "gallery/tokens.css"}}">
<link rel="stylesheet" href="{{asset "gallery/components.css"}}">
<link rel="stylesheet" href="{{asset "gallery/login.css"}}">
<link rel="stylesheet" href="{{asset "gallery/login-descent.css"}}">
</head>
<body class="login-page login-painted{{if .Descend}} login-descend{{end}}">{{template "loginScene" .Descend}}
{{template "appHeader" .Header}}
<div class="login-content">
{{template "loginIntro"}}
<main class="login">
  <p class="login-sub">Sign in to your library</p>

  {{if .Error}}
  {{/* role=alert so the message is announced when the page reloads into it —
       a failed sign-in is a page render here, not a live region update. */}}
  <p class="login-error" role="alert"><i class="ph ph-warning-circle" aria-hidden="true"></i> {{.Error}}</p>
  {{end}}

  <form class="login-form" method="post" action="/auth/local">
    {{/* Carried through the form rather than a cookie: this path has no round
         trip to an external authority to survive, so there is nothing to park.
         The value was already run through safeNext before it got here. */}}
    <input type="hidden" name="next" value="{{.Next}}">
    <label class="login-label" for="username">Username</label>
    <input class="field" type="text" id="username" name="username" value="{{.Username}}"
           autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" required autofocus>
    <label class="login-label" for="password">Password</label>
    <input class="field" type="password" id="password" name="password"
           autocomplete="current-password" required>
    <button class="btn login-submit" type="submit"><i class="ph ph-sign-in"></i> Sign in</button>
  </form>

  {{if .SSO}}
  <div class="login-or"><span>or</span></div>
  {{/* A link, not a second form: /auth/sso is the provider redirect, and the
       browser has to make a top-level navigation for the round trip to work. */}}
  <a class="btn btn-sec login-sso" href="{{.SSOHref}}"><i class="ph ph-shield-check"></i> Sign in with SSO</a>
  {{end}}
</main>
</div>
</body>
</html>{{end}}

{{define "loginFailure"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sign-in failed — Exhibit</title>
<link rel="icon" type="image/svg+xml" href="{{.Favicon}}">
{{template "pwaHead"}}
{{template "fontsHead"}}
<link rel="stylesheet" href="{{asset "phosphor/regular.css"}}">
<link rel="stylesheet" href="{{asset "gallery/tokens.css"}}">
<link rel="stylesheet" href="{{asset "gallery/components.css"}}">
<link rel="stylesheet" href="{{asset "gallery/login.css"}}">
</head>
<body class="login-page login-painted">{{template "loginScene" false}}
{{template "appHeader" .Header}}
<div class="login-content">
{{template "loginIntro"}}
<main class="login">
  <p class="login-error" role="alert">{{.Error}}</p>
  <a class="btn login-submit" href="/auth/login">Return to sign in</a>
</main></div>
</body>
</html>{{end}}
