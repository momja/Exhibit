{{/* Artifact edit page. Data: editPageData (gallery.go). */}}
{{define "edit"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Edit: {{.Title}} — Exhibit</title>
<link rel="icon" type="image/svg+xml" href="{{.Favicon}}">
{{template "pwaHead"}}
{{template "clerkScripts" .Clerk}}
<link rel="stylesheet" href="{{asset "phosphor/regular.css"}}">
<link rel="stylesheet" href="{{asset "gallery/tokens.css"}}">
<link rel="stylesheet" href="{{asset "gallery/components.css"}}">
<link rel="stylesheet" href="{{asset "gallery/edit.css"}}">
{{/* htmx drives the widget panel's preview swap (av-fafu); self-hosted from
     the app origin like every other asset, never a CDN. */}}
<script src="{{asset "htmx/htmx.min.js"}}"></script>
</head>
<body data-controller="unsaved-changes" data-editor-return-url="{{.Return.URL}}" data-action="click->unsaved-changes#navigate input->unsaved-changes#refresh change->unsaved-changes#refresh exhibit:editor-changed->unsaved-changes#refresh exhibit:editor-exit->unsaved-changes#allowExit pageshow@window->unsaved-changes#restore beforeunload@window->unsaved-changes#beforeUnload">
{{template "appHeader" .Header}}
<main>
<div class="edit-heading"><div><h1 id="edit-title">{{.Title}}</h1></div></div>
<div class="edit-card">

  {{/* The title is the one field that belongs to no section, so it stays
       above them rather than being buried in one. */}}
  <label class="field-label" for="title">Artifact title</label>
  <input type="text" id="title" value="{{.Title}}">

  {{/* The page is peer sections — tags, security, state, artifact source,
       gallery widget — each a .details-panel with the same caret and summary
       shape.
       Artifact source is the only one rendered open: it is what "Edit" means,
       and the others are things you go looking for. */}}
  {{/* Tags (tags.js). Changes save immediately via the tag API, not the
       Save button; htmx re-renders the body on exhibit:tags-changed. */}}
  <details class="details-panel" id="tags-panel" data-artifact-id="{{.ID}}">
    <summary>{{template "panelCaret"}} Tags</summary>
    <div class="panel-body">
      <p id="tag-status" class="form-help tag-status" role="status" aria-live="polite" aria-atomic="true">Adding or removing a tag saves immediately.</p>
      <fieldset id="tags-body" class="tag-fields" aria-label="Tag controls"
           hx-get="/partials/tag-panel?artifact={{.ID}}"
           hx-trigger="exhibit:tags-changed from:body, click from:#tag-refresh"
           hx-sync="this:replace"
           hx-swap="innerHTML">{{template "tagPanelBody" .TagPanel}}</fieldset>
      <div id="tag-refresh-notice" hidden>
        <p class="form-help tag-error" role="alert">Tags could not refresh. Refresh the tags to continue.</p>
        <button type="button" class="btn btn-sec" id="tag-refresh">Refresh tags</button>
      </div>
      {{template "editTagModal" .Presets}}
    </div>
  </details>

  <details class="details-panel" id="security-panel">
    <summary id="security-summary">{{template "panelCaret"}} <span>Permissions <span class="security-summary-note" id="security-summary-text"></span></span></summary>
    <div class="panel-body security-body">
      <div class="security-col">
        <div id="origin-lists"
             hx-get="/partials/edit-origins?artifact={{.ID}}"
             hx-trigger="exhibit:origin-draft-changed from:body"
             hx-sync="this:replace"
             hx-swap="innerHTML">{{template "editOriginLists" .}}</div>
        <div class="origin-add">
          <label class="field-label" for="al-add-input">Site to allow</label>
          <div class="row">
            <input type="text" id="al-add-input" class="field" placeholder="https://example.com">
            <button type="button" class="btn btn-sm btn-sec" id="al-add-btn"><i class="ph ph-plus" aria-hidden="true"></i> Add</button>
          </div>
        </div>
      </div>
      <div class="security-col">
        <h3>Features</h3>
        <label class="row">
          <span class="spacer field-label">Downloads</span>
          <select id="dl-select" class="select">
            <option value="false">Ask first</option>
            <option value="true">Always allow</option>
          </select>
        </label>
        <label class="row">
          <span class="spacer field-label">Clipboard</span>
          <select id="clip-select" class="select">
            <option value="false">Ask first</option>
            <option value="true">Always allow</option>
          </select>
        </label>
        <label class="row">
          <span class="spacer field-label">External links</span>
          <select id="link-select" class="select">
            <option value="false">Ask first</option>
            <option value="true">Always allow</option>
          </select>
        </label>
        {{/* Camera and microphone (av-mv3k) are two controls rather than one
             "media" row because they are two grants: an artifact that asked for
             a microphone was never approved for a camera. Unlike the three
             above, these also decide whether the artifact may reach the device
             when opened *directly* — they build the render document's
             Permissions-Policy header — which is what makes the grant
             per-artifact rather than per-render-origin. */}}
        <label class="row">
          <span class="spacer field-label">Camera</span>
          <select id="cam-select" class="select">
            <option value="false">Ask first</option>
            <option value="true">Always allow</option>
          </select>
        </label>
        <label class="row">
          <span class="spacer field-label">Microphone</span>
          <select id="mic-select" class="select">
            <option value="false">Ask first</option>
            <option value="true">Always allow</option>
          </select>
        </label>
        {{/* Location (av-f446) is enforced the same way as the two devices:
             the render document's Permissions-Policy header. */}}
        <label class="row">
          <span class="spacer field-label">Location</span>
          <select id="geo-select" class="select">
            <option value="false">Ask first</option>
            <option value="true">Always allow</option>
          </select>
        </label>
      </div>
    </div>
  </details>

  {{/* State inspector (av-hg5f). The panel's shell renders server-side; its
       contents are fetched client-side on first open (state.js), since state
       is cold data no other part of this page needs. */}}
  <details class="details-panel" id="state-panel">
    <summary id="state-summary">{{template "panelCaret"}} <span id="state-summary-text">Saved data</span></summary>
    <fieldset class="panel-body state-body" id="state-controls" aria-label="Saved data controls">
      <p class="form-help">
        Data saved by this artifact syncs across your devices.
      </p>
      <div id="state-rows"></div>
      <div class="state-add" id="state-add">
        <input type="text" id="state-add-key" class="field" placeholder="New key">
        <select id="state-add-type" class="select">
          <option value="string">Text</option>
          <option value="number">Number</option>
          <option value="boolean">True/false</option>
          <option value="list">List</option>
          <option value="object">Object</option>
        </select>
        <button type="button" class="btn btn-sm btn-sec" id="state-add-btn"><i class="ph ph-plus"></i> Add key</button>
      </div>
      <div class="btn-row state-actions">
        <button type="button" class="btn btn-sm" id="state-save"><i class="ph ph-floppy-disk" aria-hidden="true"></i> Save data</button>
        <button type="button" class="btn btn-sm btn-sec" id="state-cancel"><i class="ph ph-x"></i> Discard data edits</button>
        <span id="state-status" class="text-sm muted"></span>
      </div>
      <div class="panel-transfer">
        <button type="button" class="btn btn-sm btn-sec" id="state-export" aria-describedby="state-export-help"><i class="ph ph-download-simple" aria-hidden="true"></i> Export data (JSON)</button>
        <div>
          <p class="form-help" id="state-export-help">Includes saved results from connected accounts, but no credentials or unsaved edits. Review the data before sharing the file.</p>
          <span id="state-export-status" class="text-sm muted" role="status"></span>
        </div>
      </div>
      <div class="panel-transfer">
        <button type="button" class="btn btn-sm btn-sec" id="state-import" aria-describedby="state-import-help"><i class="ph ph-upload-simple" aria-hidden="true"></i> Import data (JSON)</button>
        <input type="file" id="state-import-file" accept=".json,application/json" aria-label="Import saved data JSON" hidden>
        <div>
          <p class="form-help" id="state-import-help">Replaces saved data with an exported JSON file and discards unsaved data edits.</p>
          <span id="state-import-status" class="text-sm muted" role="status"></span>
        </div>
      </div>
      <div class="btn-row state-danger-actions">
        <button type="button" class="btn btn-sm btn-sec btn-danger-outline" id="state-erase"><i class="ph ph-warning"></i> Erase current data</button>
      </div>
    </fieldset>
  </details>

  {{/* Out-of-line assets (av-20fk). The list is a server-rendered partial,
       refreshed by htmx after import and delete events. It is the only place these bytes are visible at
       all — they are deliberately not in the source below — so it is also the
       only place they can be reclaimed. */}}
  <details class="details-panel" id="assets-panel">
    <summary id="assets-summary">{{template "panelCaret"}} <span id="assets-summary-text">Stored assets</span></summary>
    <div class="panel-body">
      <p class="form-help">
        Files saved with this artifact so it can load them even if the original site changes.
      </p>
      <p class="form-help">
        Deleting a file is permanent and may break the artifact. Check its URL in the source before deleting it.
      </p>
      <div id="assets-rows" hx-get="/partials/asset-panel?artifact={{.ID}}" hx-trigger="load, exhibit:assets-changed from:body" hx-swap="innerHTML">{{template "assetPanelRows" .AssetPanel}}</div>
      <span id="assets-status" class="text-sm muted"></span>
      <div class="panel-transfer">
        <button type="button" class="btn btn-sm btn-sec" id="assets-export" aria-describedby="assets-export-help"><i class="ph ph-download-simple" aria-hidden="true"></i> Export assets (ZIP)</button>
        <div>
          <p class="form-help" id="assets-export-help">Downloads all saved files and a manifest of their source URLs and content types.</p>
          <span id="assets-export-status" class="text-sm muted" role="status"></span>
        </div>
      </div>
      <div class="panel-transfer">
        <button type="button" class="btn btn-sm btn-sec" id="assets-import" aria-describedby="assets-import-help"><i class="ph ph-upload-simple" aria-hidden="true"></i> Import assets (ZIP)</button>
        <input type="file" id="assets-import-file" accept=".zip,application/zip" aria-label="Import stored assets ZIP" hidden>
        <div>
          <p class="form-help" id="assets-import-help">Replaces saved files with a ZIP exported from this artifact.</p>
          <span id="assets-import-status" class="text-sm muted" role="status"></span>
        </div>
      </div>
    </div>
  </details>

  {{/* The artifact's own source. Saved by the page's Save button below,
       together with the title — one document, one button. */}}
  <details class="details-panel" id="source-panel" open>
    <summary>{{template "panelCaret"}} Artifact source</summary>
    <div class="panel-body">
      <div id="source-network-warnings" hx-get="/partials/network-warnings?artifact={{.ID}}"
           hx-trigger="exhibit:network-warnings-changed from:body"
           hx-swap="innerHTML">{{template "networkWarnings" .NetworkWarnings}}</div>
      <textarea id="body" aria-label="Artifact source" data-revision="{{.SourceRevision}}">{{.Src}}</textarea>
      <div id="scan-result" hx-get="/partials/network-approval?artifact={{.ID}}&amp;mode=edit"
           hx-trigger="exhibit:network-approval-changed from:body"
           hx-swap="innerHTML" hx-sync="this:replace"></div>
    </div>
  </details>

  {{/* Gallery widget panel (av-fafu). It saves through its own endpoint
       (PUT/DELETE /api/artifacts/:id/widget), not the artifact PATCH, so it
       carries its own buttons — one Save covering two different documents
       would misreport what changed.

       The preview is an htmx target: after a save the panel re-fetches the
       cardWidget fragment and swaps it in, so the tile updates without a page
       reload (which would drop both editors) and without page JS rebuilding
       markup the partial already owns. */}}
  <details class="details-panel" id="widget-panel">
    <summary>{{template "panelCaret"}} Card widget — <span id="widget-summary-text">{{if .WidgetSrc}}custom{{else}}default{{end}}</span></summary>
    <div class="panel-body widget-body">
      <div class="widget-preview">
        <div id="widget-preview-slot"
             hx-get="/partials/card-widget?artifact={{.ID}}"
             hx-trigger="exhibit:widget-saved from:body"
             hx-swap="innerHTML">{{template "cardWidget" .Widget}}</div>
        <p class="form-help">A read-only preview on this artifact’s Gallery card. It can show saved data; clicking it opens the artifact.</p>
      </div>
      <div class="widget-source">
        <label class="field-label" for="widget-src">Widget HTML</label>
        <textarea id="widget-src" data-revision="{{.WidgetRevision}}" spellcheck="false" aria-describedby="widget-source-help">{{.WidgetSrc}}</textarea>
        <p class="form-help" id="widget-source-help">Enter a complete HTML document for the card widget. To use the default widget instead, choose Remove.</p>
        {{/* Generate takes no prompt: the button IS the request, and the whole
             instruction lives server-side (agent.GenerateWidgetPrompt, prompts/generate_widget.tmpl
             plus the session's WidgetOnly system prompt), so there is nothing
             here for a caller to put into the model's context. Disabled with
             its reason in the title when the agent can't run. */}}
        <div class="btn-row">
          <button type="button" class="btn btn-sm" id="widget-generate"{{if not .CanGenerateWidget}} disabled title="{{.GenerateHint}}"{{end}}><i class="ph ph-sparkle"></i> <span id="widget-generate-label">{{if .WidgetSrc}}Regenerate{{else}}Generate widget{{end}}</span></button>
          <button type="button" class="btn btn-sm btn-sec" id="widget-remove"><i class="ph ph-trash"></i> Remove</button>
          <span id="widget-status" class="text-sm muted"></span>
        </div>
      </div>
    </div>
  </details>

  {{/* Version history. Every change to the source or the widget is kept, along
       with the saved data the code had written when the next change replaced
       it, so a restore puts back a pair that belongs together. Server-rendered:
       the list is cold data, and the only script is the restore and close
       buttons' (versions.js). Viewing a version is an htmx swap into the slot
       below and writes nothing; restoring reloads the page, because the source
       editor above holds the old text. */}}
  <details class="details-panel" id="versions-panel">
    <summary>{{template "panelCaret"}} Versions</summary>
    <div class="panel-body">
      <p class="form-help">
        Versions keep the source, widget, and saved data. Restoring adds a new version and keeps the current one in history.
      </p>
      {{/* Where a version being looked at appears (the versionViewer partial,
           fetched by a row's View button). Above the list so it is the first
           thing the panel shows once opened, and with the restore beside it:
           looking is how a person decides, so deciding is offered where they
           are looking. Empty until a version is viewed. */}}
      <div id="version-viewer-slot"></div>
      <div id="versions-rows" hx-get="/partials/edit-versions?artifact={{.ID}}" hx-trigger="exhibit:artifact-saved from:body, exhibit:widget-saved from:body" hx-swap="innerHTML" hx-sync="this:replace">{{template "editVersionRows" .}}</div>
      <span id="versions-status" class="text-sm muted"></span>
    </div>
  </details>

  <div class="btn-row editor-footer">
    <a class="btn btn-sec" href="{{.Return.URL}}">Return to {{.Return.Label}}</a>
    <span id="status"></span>
    <span class="spacer"></span>
    <button class="btn btn-sec editor-delete" type="button" data-delete-artifact><i class="ph ph-trash" aria-hidden="true"></i> Delete</button>
  </div>
</div>
</main>
{{template "editorLeaveDialog"}}
{{template "componentScripts"}}
{{/* components.js carries the widget-tile health watcher (av-fafu), which the
     widget panel's preview needs like any other page rendering a tile. */}}
<script src="{{asset "gallery/components.js"}}"></script>
<script src="{{asset "editor.js"}}"></script>
<script>
const TOKEN = {{.Token}};
{{/* READ_ONLY and TOKEN are one decision, made server-side per request
     (av-5imk, pagecredential.go): a session-authenticated browser gets no
     token because its cookie already authenticates it, an anonymous visitor
     gets no token and READ_ONLY, and a single-user instance with no identity
     provider gets the static token it has always had. api.js is what spends
     the result — page scripts never build an Authorization header. Literal
     template text for the boolean, matching the other bootstrap flags:
     html/template's JS escaper pads a {{value}} boolean with spaces. */ -}}
const READ_ONLY = {{if .ReadOnly}}true{{else}}false{{end}};
const ID = {{.ID}};
{{/* The persisted title, not the (editable) title field: the erase-all
     confirmation must name the artifact the server will actually wipe. */ -}}
let TITLE = {{.Title}};
const INITIAL_SOURCE_FOOTPRINT = {{.NetworkFootprint}};
let allowlist = {{.Allowlist}};
let unapproved = {{.Unapproved}};
let blocked = {{.Blocked}};
{{/* Literal template text rather than {{value}} interpolation, matching the
     detail page bootstrap (av-p3gj): html/template's JS escaper pads
     booleans with spaces, and a plain `= true;` keeps this greppable. */ -}}
let downloadsApproved = {{if .DownloadsApproved}}true{{else}}false{{end}};
let clipboardApproved = {{if .ClipboardApproved}}true{{else}}false{{end}};
let linksApproved = {{if .LinksApproved}}true{{else}}false{{end}};
let cameraApproved = {{if .CameraApproved}}true{{else}}false{{end}};
let microphoneApproved = {{if .MicrophoneApproved}}true{{else}}false{{end}};
let geolocationApproved = {{if .GeolocationApproved}}true{{else}}false{{end}};
</script>
<script src="{{asset "gallery/api.js"}}"></script>
<script type="module" src="{{asset "gallery/edit.js"}}"></script>
<script src="{{asset "gallery/state-api.js"}}"></script>
<script type="module" src="{{asset "gallery/state.js"}}"></script>
<script type="module" src="{{asset "gallery/state-export.js"}}"></script>
<script type="module" src="{{asset "gallery/assets.js"}}"></script>
<script type="module" src="{{asset "gallery/storage-import.js"}}"></script>
<script type="module" src="{{asset "gallery/assets-export.js"}}"></script>
<script type="module" src="{{asset "gallery/versions.js"}}"></script>
<script type="module" src="{{asset "gallery/tags.js"}}"></script>
</body>
</html>{{end}}
