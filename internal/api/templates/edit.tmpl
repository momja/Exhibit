{{/* Artifact edit page. Data: editPageData (gallery.go). */}}
{{define "edit"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Edit: {{.Title}} — Exhibit</title>
{{template "pwaHead"}}
<link rel="stylesheet" href="/assets/phosphor/regular.css">
<link rel="stylesheet" href="/assets/gallery/tokens.css">
<link rel="stylesheet" href="/assets/gallery/components.css">
<link rel="stylesheet" href="/assets/gallery/edit.css">
{{/* htmx drives the widget panel's preview swap (av-fafu); self-hosted from
     the app origin like every other asset, never a CDN. */}}
<script src="/assets/htmx/htmx.min.js"></script>
</head>
<body data-scale-reload-warn>
<header>
  <a href="/artifacts/{{.ID}}">← Back</a>
  <h1>Edit Artifact</h1>
  <span class="spacer"></span>
  {{template "textScale"}}
</header>
<main>
<div class="edit-card">
  <h2>Edit</h2>

  {{/* The title is the one field that belongs to no section, so it stays
       above them rather than being buried in one. */}}
  <input type="text" id="title" value="{{.Title}}" placeholder="Title">

  {{/* The page is peer sections — security, state, artifact source, gallery
       widget — each a .details-panel with the same caret and summary shape.
       Artifact source is the only one rendered open: it is what "Edit" means,
       and the others are things you go looking for. */}}
  <details class="details-panel" id="security-panel">
    <summary id="security-summary">{{template "panelCaret"}} <span id="security-summary-text"></span></summary>
    <div class="panel-body security-body">
      <div class="security-col">
        <h3 class="text-sm muted">Network allowlist</h3>
        <div id="allowlist-rows">
          {{range .Allowlist}}<div class="allowlist-row" data-origin="{{.}}">
            <code title="{{.}}">{{.}}</code>
            <button type="button" class="btn btn-sm btn-sec" data-action="remove">Remove</button>
          </div>{{end}}
        </div>
        {{if .Unapproved}}
        <h3 class="text-sm muted">Referenced, not approved</h3>
        <div id="unapproved-rows">
          {{range .Unapproved}}<div class="allowlist-row" data-origin="{{.}}">
            <code title="{{.}}">{{.}}</code>
            <button type="button" class="btn btn-sm" data-action="allow">Allow</button>
          </div>{{end}}
        </div>
        {{end}}
        {{if .Blocked}}
        {{/* Origins with an explicit block decision (exhibit-x87). They never
             reach the CSP; they are listed so a "don't ask again" answer stays
             visible and reversible instead of reading as merely undecided. */}}
        <h3 class="text-sm muted">Blocked</h3>
        <div id="blocked-rows">
          {{range .Blocked}}<div class="allowlist-row" data-origin="{{.}}">
            <code title="{{.}}">{{.}}</code>
            <span class="text-sm muted">blocked</span>
            <button type="button" class="btn btn-sm" data-action="allow">Allow</button>
          </div>{{end}}
        </div>
        {{end}}
        <div class="row" style="margin-top:8px">
          <input type="text" id="al-add-input" class="field" placeholder="Add origin (https://example.com)">
          <button type="button" class="btn btn-sm" id="al-add-btn">Add</button>
        </div>
      </div>
      <div class="security-col">
        <h3 class="text-sm muted">Capabilities</h3>
        <label class="row">
          <span class="spacer">Downloads</span>
          <select id="dl-select" class="select">
            <option value="false">Ask first</option>
            <option value="true">Always allow</option>
          </select>
        </label>
        <label class="row">
          <span class="spacer">Clipboard</span>
          <select id="clip-select" class="select">
            <option value="false">Ask first</option>
            <option value="true">Always allow</option>
          </select>
        </label>
      </div>
    </div>
  </details>

  {{/* State inspector (av-hg5f). The panel's shell renders server-side; its
       contents are fetched client-side on first open (state.js), since state
       is cold data no other part of this page needs. */}}
  <details class="details-panel" id="state-panel">
    <summary id="state-summary">{{template "panelCaret"}} <span id="state-summary-text">Stored state</span></summary>
    <div class="panel-body state-body">
      <p class="text-sm muted">
        Data this artifact saved through <code>localStorage</code>, held on the server so it
        follows you between devices. Each value is edited through the control its type implies —
        never as raw text.
      </p>
      <div id="state-rows"></div>
      <div class="state-add" id="state-add">
        <input type="text" id="state-add-key" class="field" placeholder="New key">
        <select id="state-add-type" class="select">
          <option value="string">Text</option>
          <option value="number">Number</option>
          <option value="boolean">True/false</option>
          <option value="list">List</option>
          <option value="object">Object</option>
        </select>
        <button type="button" class="btn btn-sm" id="state-add-btn"><i class="ph ph-plus"></i> Add key</button>
      </div>
      <div class="btn-row state-actions">
        <button type="button" class="btn btn-sm" id="state-save"><i class="ph ph-check"></i> Save state</button>
        <button type="button" class="btn btn-sm btn-sec" id="state-cancel"><i class="ph ph-x"></i> Cancel</button>
        <span id="state-status" class="text-sm muted"></span>
        <span class="spacer"></span>
        <button type="button" class="btn btn-sm btn-danger" id="state-erase"><i class="ph ph-warning"></i> Erase all data</button>
      </div>
    </div>
  </details>

  {{/* The artifact's own source. Saved by the page's Save button below,
       together with the title — one document, one button. */}}
  <details class="details-panel" id="source-panel" open>
    <summary>{{template "panelCaret"}} Artifact source</summary>
    <div class="panel-body">
      <textarea id="body">{{.Src}}</textarea>
      <div id="scan-result"></div>
    </div>
  </details>

  {{/* Gallery widget panel (av-fafu). It saves through its own endpoint
       (PUT/DELETE /api/artifacts/:id/widget), not the artifact PATCH, so it
       carries its own buttons — one Save covering two different documents
       would misreport what changed.

       The preview is an htmx target: after a save the panel re-fetches the
       cardWidget fragment and swaps it in, so the tile updates without a page
       reload (which would drop both editors) and without page JS rebuilding
       markup the partial already owns. */}}
  <details class="details-panel" id="widget-panel">
    <summary>{{template "panelCaret"}} Gallery widget — <span id="widget-summary-text">{{if .WidgetSrc}}custom tile{{else}}default tile{{end}}</span></summary>
    <div class="panel-body widget-body">
      <div class="widget-preview">
        <div id="widget-preview-slot"
             hx-get="/partials/card-widget?artifact={{.ID}}"
             hx-trigger="exhibit:widget-saved from:body"
             hx-swap="innerHTML">{{template "cardWidget" .Widget}}</div>
        <p class="text-sm muted">The tile this artifact shows on its library card. It reads the artifact's saved state but cannot change it, and it is not interactive — clicking it opens the artifact.</p>
      </div>
      <div class="widget-source">
        <textarea id="widget-src" spellcheck="false" placeholder="A complete HTML document for the tile. Leave this empty to keep the default tile.">{{.WidgetSrc}}</textarea>
        {{/* Generate takes no prompt: the button IS the request, and the whole
             instruction lives server-side (widget.go's generateWidgetPrompt
             plus the session's WidgetOnly system prompt), so there is nothing
             here for a caller to put into the model's context. Disabled with
             its reason in the title when the agent can't run. */}}
        <div class="btn-row">
          <button type="button" class="btn btn-sm" id="widget-generate"{{if not .CanGenerateWidget}} disabled title="{{.GenerateHint}}"{{end}}><i class="ph ph-sparkle"></i> <span id="widget-generate-label">{{if .WidgetSrc}}Regenerate{{else}}Generate widget{{end}}</span></button>
          <button type="button" class="btn btn-sm btn-sec" id="widget-save"><i class="ph ph-check"></i> Save widget</button>
          <button type="button" class="btn btn-sm btn-sec" id="widget-remove"><i class="ph ph-trash"></i> Remove</button>
          <span id="widget-status" class="text-sm muted"></span>
        </div>
      </div>
    </div>
  </details>

  <div class="btn-row">
    <button class="btn" onclick="save()"><i class="ph ph-check"></i> Save</button>
    <a href="/artifacts/{{.ID}}"><button class="btn btn-sec" type="button"><i class="ph ph-x"></i> Cancel</button></a>
    <span id="status"></span>
    <span class="spacer"></span>
    <button class="btn btn-danger" type="button" onclick="deleteArtifact()"><i class="ph ph-trash"></i> Delete</button>
  </div>
</div>
</main>
{{/* components.js carries the widget-tile health watcher (av-fafu), which the
     widget panel's preview needs like any other page rendering a tile. */}}
<script src="/assets/gallery/components.js"></script>
<script src="/assets/editor.js"></script>
<script>
const TOKEN = {{.Token}};
const ID = {{.ID}};
{{/* The persisted title, not the (editable) title field: the erase-all
     confirmation must name the artifact the server will actually wipe. */ -}}
const TITLE = {{.Title}};
let allowlist = {{.Allowlist}};
let unapproved = {{.Unapproved}};
let blocked = {{.Blocked}};
{{/* Literal template text rather than {{value}} interpolation, matching the
     detail page bootstrap (av-p3gj): html/template's JS escaper pads
     booleans with spaces, and a plain `= true;` keeps this greppable. */ -}}
let downloadsApproved = {{if .DownloadsApproved}}true{{else}}false{{end}};
let clipboardApproved = {{if .ClipboardApproved}}true{{else}}false{{end}};
</script>
<script src="/assets/gallery/edit.js"></script>
<script src="/assets/gallery/state-api.js"></script>
<script src="/assets/gallery/state.js"></script>
</body>
</html>{{end}}
