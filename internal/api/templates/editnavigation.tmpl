{{define "editorLeaveDialog"}}<dialog class="editor-leave-dialog" data-unsaved-changes-target="dialog" data-action="cancel->unsaved-changes#keepEditing" aria-labelledby="editor-leave-title">
  <h2 id="editor-leave-title">Save changes before leaving?</h2>
  <p>Your unsaved edits will be discarded if you leave without saving. Changes already saved stay saved.</p>
  <div class="btn-row">
    <button type="button" class="btn btn-sec" data-keep-editing data-action="unsaved-changes#keepEditing">Keep editing</button>
    <button type="button" class="btn btn-sec" data-action="unsaved-changes#discard">Discard changes</button>
    <button type="button" class="btn" data-action="unsaved-changes#saveAndLeave">Save and leave</button>
  </div>
</dialog>{{end}}

{{define "editVersionRows"}}
<p class="text-sm muted">{{len .Versions}} saved version{{if ne (len .Versions) 1}}s{{end}}</p>
{{range .Versions}}<div class="version-row" data-seq="{{.Seq}}">
  <span class="version-seq">v{{.Seq}}</span>
  <span class="version-what"><strong>{{.Label}}</strong>{{if .Message}} <span class="muted">— {{.Message}}</span>{{end}}</span>
  <time class="text-sm muted version-when" datetime="{{.WhenISO}}">{{.When}}</time>
  {{if .Current}}<span class="text-sm muted">current</span>{{else}}<button type="button" class="btn btn-sm btn-sec" data-action="view" data-seq="{{.Seq}}" hx-get="/partials/version-viewer?artifact={{$.ID | urlquery}}&amp;seq={{.Seq}}&amp;restorable=1" hx-target="#version-viewer-slot" hx-swap="innerHTML"><i class="ph ph-eye" aria-hidden="true"></i> View</button> <button type="button" class="btn btn-sm btn-sec" data-action="restore" data-seq="{{.Seq}}"><i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i> Restore</button>{{end}}
</div>{{end}}
{{end}}
