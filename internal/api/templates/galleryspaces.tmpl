{{/* Spaces and filters share a desktop rail. Only spaces become phone tabs. */}}
{{define "gallerySpaces"}}<aside class="gallery-rail"{{if .Spaces}} data-controller="space-tabs"{{end}}>
  {{if .Spaces}}<nav class="gallery-spaces" aria-label="Library spaces">
    <ul>{{range .Spaces}}
      <li{{if .MobileOnly}} class="space-mobile-only"{{end}}><a href="{{.Path}}"{{if .Active}} aria-current="page"{{end}} data-gallery-space-link
        hx-get="{{.Path}}" hx-target="#gallery-content" hx-swap="outerHTML" hx-push-url="true" hx-sync="#gallery-shell:replace">
        <i class="ph {{.Icon}}" aria-hidden="true"></i>
        <span class="space-label">{{.Label}}</span>
        {{if .ShowCount}}<span class="space-count">{{.Count}}</span>{{end}}
      </a></li>{{end}}
    </ul>
  </nav>{{end}}
  <div id="{{.Grid.ID}}-rail-filters" class="gallery-rail-filters" hx-target:inherited="#{{.Grid.ID}}-results" hx-swap:inherited="innerHTML" hx-sync:inherited="#{{.Grid.ID}}:replace" hx-include:inherited="#{{.Grid.ID}}-search [name=q]">{{template "galleryFilterOptions" .Grid}}</div>
</aside>{{end}}
