{{/* The rail can later hold tag/collection filter sections below this nav.
     CSS lays out this same markup as a bottom tab bar on narrow screens. */}}
{{define "gallerySpaces"}}<aside class="gallery-rail">
  <nav class="gallery-spaces" aria-label="Library spaces">
    <ul>{{range .}}
      <li><a href="{{.Path}}"{{if .Active}} aria-current="page"{{end}}>
        <i class="ph {{.Icon}}" aria-hidden="true"></i>
        <span class="space-label-wide">{{.Label}}</span><span class="space-label-short" aria-hidden="true">{{.ShortLabel}}</span>
        {{if .ShowCount}}<span class="space-count">{{.Count}}</span>{{end}}
      </a></li>{{end}}
    </ul>
  </nav>
</aside>{{end}}
