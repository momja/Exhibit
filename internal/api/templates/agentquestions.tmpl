{{define "agentInteraction"}}<section class="agent-interaction agent-questions" id="agent-interaction-{{.ID}}" data-interaction-id="{{.ID}}" data-interaction-kind="{{.Kind}}" data-interaction-state="{{.State}}" data-revision="{{.Revision}}" data-pending="{{.Pending}}" data-session-id="{{.SessionID}}" aria-label="Questions from the agent">
  {{if eq .Kind "questions"}}{{template "agentQuestionsBody" .Questions}}{{end}}
</section>{{end}}

{{define "agentQuestionsBody"}}{{if .Pending}}
  <form data-question-form data-controller="agent-questions" data-action="submit->agent-questions#send keydown->agent-questions#keyDown" novalidate>
    <div class="question-heading"><span>Questions for you</span><span class="question-progress" data-agent-questions-target="progress" aria-live="polite">0 of {{len .Questions}} answered</span></div>
    <p class="question-help">Answer each question, then send. You can change your answers first.</p>
    {{range .Questions}}
    <fieldset data-question-id="{{.ID}}" data-multi-select="{{.MultiSelect}}">
      <legend>{{.Question}}</legend>
      {{if .MultiSelect}}<p class="question-instruction">Choose any that apply.</p>{{end}}
      {{if .Options}}<div class="question-options">{{range .Options}}
        <button type="button" class="question-option" data-question-choice data-action="agent-questions#choose" value="{{.Label}}" aria-pressed="false"><i class="ph ph-check" aria-hidden="true"></i><span><span class="question-option-label">{{.Label}}</span>{{if .Description}}<span class="question-option-description">{{.Description}}</span>{{end}}</span></button>
      {{end}}</div>
      <details class="question-other" data-action="toggle->agent-questions#focusOther"><summary>{{if .MultiSelect}}Add a detail{{else}}Write a different answer{{end}}</summary>{{template "agentQuestionInput" .}}</details>
      {{else}}{{template "agentQuestionInput" .}}{{end}}
    </fieldset>
    {{end}}
    <p class="interaction-status question-status" data-agent-questions-target="status" role="status" aria-live="polite"></p>
    <div class="question-actions"><button class="btn question-submit" type="submit">Send answers <i class="ph ph-arrow-up" aria-hidden="true"></i></button><button class="question-skip" type="button" data-agent-questions-target="skipTrigger" data-action="agent-questions#skip">Skip questions</button></div>
    <div class="question-skip-confirmation" data-agent-questions-target="skipConfirmation" hidden>
      <p>Skip this set? Your drafted answers won’t be sent.</p>
      <div class="question-actions"><button class="question-skip" type="button" data-action="agent-questions#keepAnswering">Keep answering</button><button class="question-skip" type="button" data-action="agent-questions#confirmSkip">Skip questions</button></div>
    </div>
    <p class="question-help question-chat-help">You can also reply in chat to change direction.</p>
  </form>
  {{else}}
    {{template "agentQuestionSummary" .}}
  {{end}}{{end}}

{{define "agentQuestionInput"}}<textarea aria-label="{{.Question}}" rows="2" maxlength="8000" placeholder="Your answer…" data-action="input->agent-questions#edit"></textarea>{{end}}

{{define "agentQuestionSummary"}}{{if .Blocked}}<p class="question-skipped">Reply not sent.</p>{{else if .Expired}}<p class="question-skipped">Questions closed. No answers were sent.</p>{{else if .Cancelled}}<p class="question-skipped">Questions skipped. No answers were sent.</p>{{else}}<p class="question-completed"><i class="ph ph-check-circle" aria-hidden="true"></i> {{if .Message}}Replied in chat{{else}}Answers sent{{end}}</p>{{end}}{{range $index, $question := .Questions}}<div class="question-summary"><p class="question-summary-prompt">{{.Question}}</p>{{if and (not $.Cancelled) (not $.Message)}}{{with index $.Answers $index}}{{range .Selected}}<p class="question-summary-answer">{{.}}</p>{{end}}{{if .Text}}<p class="question-summary-answer">{{.Text}}</p>{{end}}{{end}}{{end}}</div>{{end}}{{if .Message}}<div class="msg user question-message">{{.Message}}</div>{{end}}{{end}}

{{define "agentQuestionHistory"}}<section class="agent-questions" aria-label="Questions from the agent">{{template "agentQuestionSummary" .}}</section>{{end}}
