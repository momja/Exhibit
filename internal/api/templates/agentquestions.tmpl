{{define "agentQuestions"}}<section class="agent-questions" id="agent-question-{{.ID}}" data-pending="{{.Pending}}" data-session-id="{{.SessionID}}" data-request-id="{{.ID}}" aria-label="Questions from the agent">
  {{if .Pending}}
  <form data-question-form novalidate>
    {{range $index, $question := .Questions}}
    <fieldset data-question-id="{{.ID}}" data-multi-select="{{.MultiSelect}}">
      <legend>{{.Question}}</legend>
      {{if .Options}}<div class="question-options">{{range .Options}}
        <label class="question-option"><input type="{{if $question.MultiSelect}}checkbox{{else}}radio{{end}}" name="question-{{$index}}" value="{{.Label}}"><span><span class="question-option-label">{{.Label}}</span>{{if .Description}}<span class="question-option-description">{{.Description}}</span>{{end}}</span></label>
      {{end}}</div>
      <details class="question-other"><summary>Something else</summary>{{template "agentQuestionInput" .}}</details>
      {{else}}{{template "agentQuestionInput" .}}{{end}}
    </fieldset>
    {{end}}
    <p class="question-status" role="status" aria-live="polite"></p>
    <div class="question-actions"><button class="btn" type="submit">Continue</button><button class="question-skip" type="button" data-question-skip>Skip</button></div>
  </form>
  {{else}}
    {{template "agentQuestionSummary" .QuestionRequest}}
  {{end}}
</section>{{end}}

{{define "agentQuestionInput"}}<textarea aria-label="{{.Question}}" rows="1" maxlength="8000" placeholder="Your answer…"></textarea>{{end}}

{{define "agentQuestionSummary"}}{{range $index, $question := .Questions}}<div class="question-summary"><p class="question-summary-prompt">{{.Question}}</p>{{if not $.Cancelled}}{{with index $.Answers $index}}{{range .Selected}}<p class="question-summary-answer">{{.}}</p>{{end}}{{if .Text}}<p class="question-summary-answer">{{.Text}}</p>{{end}}{{end}}{{end}}</div>{{end}}{{if .Cancelled}}<p class="question-skipped">Skipped</p>{{end}}{{end}}

{{define "agentQuestionHistory"}}<section class="agent-questions" aria-label="Questions from the agent">{{template "agentQuestionSummary" .}}</section>{{end}}
