{{/* Own-account settings. Data: profilePageData (profile.go). Clerk owns
     profile and security; this page owns storage, connected agents and library deletion. All
     data is resolved from the session owner, never an account ID in the URL. */}}
{{define "profile"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Settings — Exhibit</title>
<link rel="icon" type="image/svg+xml" href="{{.Favicon}}">
{{template "pwaHead"}}
{{template "clerkScripts" .Clerk}}
<link rel="stylesheet" href="{{asset "phosphor/regular.css"}}">
<link rel="stylesheet" href="{{asset "gallery/tokens.css"}}">
<link rel="stylesheet" href="{{asset "gallery/components.css"}}">
<link rel="stylesheet" href="{{asset "gallery/settings.css"}}">
{{if .AgentGrants}}<script src="{{asset "htmx/htmx.min.js"}}"></script>{{end}}
</head>
<body>
{{template "appHeader" .Header}}
<main class="settings">
<div class="lede">
  <h2>Settings</h2>
</div>

<div class="card">
  <h3 class="settings-h3">Profile</h3>
  {{if .Account.SignedIn}}
  <dl class="settings-facts">
    <dt>Signed in as</dt>
    {{/* An identity provider is not obliged to send an email, and users.email
         is NOT NULL DEFAULT '' rather than guaranteed — so the name can be
         the provider's subject claim instead, and when it is, the page says
         so. An opaque identifier offered as "you" reads as a bug; the same
         identifier labelled as what it is reads as an answer. */}}
    <dd>{{if .Account.Name}}<span class="settings-name">{{.Account.Name}}</span>{{else}}<span class="muted">Signed in through your identity provider</span>{{end}}</dd>
    <dt>Sign-in</dt>
    <dd>{{if .Account.HasPassword}}<i class="ph ph-key" aria-hidden="true"></i> Password{{else}}<i class="ph ph-shield-check" aria-hidden="true"></i> Identity provider{{end}}</dd>
  </dl>
  {{if .Account.NameIsSubject}}<p class="muted text-sm settings-note">Your identity provider did not share an email address. The account ID above identifies you to administrators.</p>{{end}}
  {{if .Clerk}}
  <div class="settings-foot" data-controller="clerk" data-clerk-mode-value="manage">
    <button class="btn btn-sec" type="button" data-action="clerk#openProfile"><i class="ph ph-user-circle" aria-hidden="true"></i> Manage profile</button>
    <span data-clerk-target="status" role="status"></span>
  </div>
  <p class="muted text-sm settings-note">Update your name, email, and sign-in methods in your profile.</p>
  {{else if not .Account.HasPassword}}<p class="muted text-sm settings-note">Manage your password and sign-in methods with your identity provider.</p>{{end}}
  {{else}}
  {{/* No login is configured on this instance, so sessionGate is a
       pass-through, ownerMiddleware supplied the single-user default, and
       there is no users row behind it. Nothing is missing — that is the
       self-hoster's default shape — so the page says what it is instead of
       showing an account it made up. */}}
  <p class="muted">Sign-in is not configured. Anyone who can reach this Exhibit instance can access its library.</p>
  {{end}}
</div>

{{if .IsAdmin}}<div class="card">
  <h3 class="settings-h3">Administration</h3>
  <a class="btn btn-sec account-admin-link" href="/admin/users"><i class="ph ph-users-three" aria-hidden="true"></i> Accounts</a>
</div>{{end}}

{{if .Account.SignedIn}}
<section class="card" id="storage" aria-labelledby="storage-heading">
  <h3 class="settings-h3" id="storage-heading"><i class="ph ph-hard-drives" aria-hidden="true"></i> Storage</h3>
  <dl class="settings-facts">
    <dt>Storage used</dt><dd>{{.Account.Storage}}</dd>
    <dt>Artifacts</dt><dd>{{.Account.Artifacts}}</dd>
  </dl>
  <p class="muted text-sm settings-note">Includes artifact files, widgets, versions, and assets.</p>
</section>
{{end}}

{{with .AgentGrants}}{{template "agentGrantsPanel" .}}{{end}}
{{if .Connections.Enabled}}
<div class="card">
  <h3 class="settings-h3">Connected accounts <span class="muted text-sm">Experimental</span></h3>
  <p class="settings-copy">Choose which artifacts can use your accounts. Account access stays personal when you share an artifact.</p>
  <div class="settings-foot"><a class="btn btn-sec" href="/connections"><i class="ph ph-key" aria-hidden="true"></i> Manage connections</a></div>
</div>
{{end}}

{{/* Sign out (nw-a1ef). The session was revocable from the first day it
     existed, since /auth/logout deletes the row, and nothing in the UI ever
     pointed at it. Clearing a cookie by hand was the only way out.

     It sits below Account and above the danger zone, which is the order of
     consequence: reading about yourself, ending a session, then the one act
     with no undo. A sign-out card wedged under the red one would read as part
     of it.

     A POST, not the link /auth/logout also answers. Both verbs are registered
     (auth.go) and a forged logout achieves nothing worse than an
     inconvenience, so this is not a CSRF argument. It is that a GET is
     something a browser or an extension may fetch on its own: a speculative
     prefetch of a sign-out link signs the user out with no click anywhere,
     and the form costs one element to rule that out.

     Rendered only when there is a session to end. An instance with no login
     registers no /auth/logout at all, so the button would 404 there. */}}
{{if .Account.CanSignOut}}
<div class="card">
  <h3 class="settings-h3">Sign out</h3>
  <p class="settings-copy">Sign out on this device.</p>
  <form class="settings-foot" method="post" action="/auth/logout">
    <button class="btn btn-sec" type="submit"><i class="ph ph-sign-out" aria-hidden="true"></i> Sign out</button>
  </form>
</div>
{{end}}

{{/* Go owns both confirmation steps. Hosted deletion also removes the Clerk
     identity; self-hosted deletion leaves its external provider untouched. */}}
{{template "accountDeletion" .}}
</main>

<script>
const TOKEN = {{.Token}};
{{/* The same per-request credential contract every other page carries
     (av-5imk, pagecredential.go): a session-authenticated browser is handed
     no token, because its cookie already authenticates it. The deletion above
     is a mutation through the JSON API like any other client's, so it spends
     this rather than inventing a credential of its own. */ -}}
const READ_ONLY = {{if .ReadOnly}}true{{else}}false{{end}};
</script>
<script src="{{asset "gallery/api.js"}}"></script>
<script type="module" src="{{asset "gallery/profile.js"}}"></script>
{{if .AgentGrants}}<script type="module" src="{{asset "gallery/agent-grants.js"}}"></script>{{end}}
</body>
</html>{{end}}

{{define "accountDeletion"}}<div class="card card-danger" data-controller="account-deletion" data-account-deletion-hosted-value="{{if .Clerk}}true{{else}}false{{end}}">
  <h3 class="settings-h3 settings-h3-danger"><i class="ph ph-warning-octagon" aria-hidden="true"></i> Delete account</h3>
  <p class="settings-danger-copy">Permanently delete your Exhibit account, library, saved data, and share links.</p>
  {{if .Connections.Enabled}}<p class="settings-danger-copy">Connected services are disconnected first. If a service is unavailable, deletion pauses so you can retry. Some services may already be disconnected.</p>{{end}}
  {{if .Account.SignedIn}}
  {{/* Counted rather than gestured at, and shares first among equals: an
       artifact is your own, but a share is access somebody else may be
       relying on — a link anyone may hold, or a grant on their account —
       with no account here guaranteed and no way to be told it stopped
       working. */}}
  <p class="settings-danger-copy">This account holds <strong>{{.Account.Artifacts}}</strong>.{{if .Account.ShareCount}} Deleting it ends <strong>{{.Account.Shares}}</strong>, including access other people rely on.{{end}}</p>
  {{/* State the different reach of hosted and self-hosted deletion. */}}
  {{if .Clerk}}
  <p class="settings-danger-copy">Your profile and sign-in methods stored with Clerk will also be deleted. Your Google, Apple, or other provider accounts are unaffected.</p>
  {{else if not .Account.HasPassword}}
  <p class="settings-danger-copy">Next time you sign in with your identity provider, you will be treated as a new user.</p>
  {{end}}
  {{end}}
  <div class="settings-foot">
    {{if .Account.DeleteBlocked}}
    <button class="btn btn-danger" type="button" id="delete-account" disabled data-account-deletion-target="trigger" aria-describedby="delete-account-reason">
      <i class="ph ph-trash" aria-hidden="true"></i> Delete account
    </button>
    <span class="muted text-sm" id="delete-account-reason">{{.Account.DeleteBlocked}}</span>
    {{else}}
    <button class="btn btn-danger" type="button" id="delete-account" data-account-deletion-target="trigger" data-action="account-deletion#open" aria-expanded="false" aria-controls="delete-confirm">
      <i class="ph ph-trash" aria-hidden="true"></i> Delete account
    </button>
    {{end}}
  </div>

  {{if not .Account.DeleteBlocked}}
  <div class="settings-confirm" id="delete-confirm" hidden data-account-deletion-target="panel">
    {{/* Assembled from clauses that are each conditional on their own count,
         because a sentence built around "your no artifacts" is how a
         confirmation stops being read. */}}
    <p class="settings-danger-copy"><strong>This cannot be undone.</strong> Your library will be permanently deleted{{if .Account.ArtifactCount}} including {{.Account.Artifacts}} and everything saved inside{{end}}.{{if .Account.ShareCount}} {{.Account.Shares}} will stop working.{{end}}</p>
    {{if .Clerk}}
    <p class="settings-danger-copy">Your Exhibit library and your sign-in account will be permanently deleted. You will be signed out on every device. This does not delete your Google, Apple, or other provider accounts.</p>
    {{else if .Account.HasPassword}}
    <p class="settings-danger-copy">If you revisit this site, you will be treated as a new user.</p>
    {{else}}
    <p class="settings-danger-copy">Signing in again will still work via your identity provider. You will arrive at a new account, with an empty library.</p>
    {{end}}
    <label class="settings-label" for="delete-phrase">Type <code>delete my library</code> to confirm</label>
    <input class="field settings-confirm-field" type="text" id="delete-phrase" data-account-deletion-target="phrase" data-action="input->account-deletion#update" autocomplete="off"
           autocapitalize="none" spellcheck="false" placeholder="delete my library">
    <div class="settings-foot">
      <button class="btn btn-danger" type="button" id="delete-confirm-go" data-account-deletion-target="submit" data-action="account-deletion#submit" disabled>
        <i class="ph ph-trash" aria-hidden="true"></i> {{if .Clerk}}Delete my account permanently{{else}}Delete my library permanently{{end}}
      </button>
      <button class="btn" type="button" id="delete-cancel" data-account-deletion-target="cancel" data-action="account-deletion#cancel">Cancel</button>
    </div>
  </div>
  {{end}}
  {{/* One live region for the outcome, the same idiom /admin/users uses. The
       refusals worth reading in full are the ones this page can still get
       after the button was enabled — the last-admin race, above all — so it is
       a block of text rather than a toast that leaves. */}}
  {{if .Clerk}}<a class="btn btn-sec" href="/auth/logout" data-account-deletion-target="finish" hidden>Return to sign in</a>{{end}}
  <div class="settings-status" id="profile-status" data-account-deletion-target="status" role="status" aria-live="polite" hidden></div>
</div>{{end}}


{{define "agentGrantsPanel"}}<section class="card" id="agent-grants-panel"{{if .MCPURL}} data-mcp-url="{{.MCPURL}}"{{end}} aria-labelledby="agent-grants-heading">
  <h3 class="settings-h3" id="agent-grants-heading"><i class="ph ph-robot" aria-hidden="true"></i> Connected agents</h3>
  {{if .MCPURL}}<p class="settings-copy">Connect your own agent to find, create and edit artifacts in your library. Each connection stays active until you revoke it.</p>
  <label class="settings-label" for="agent-mcp-url">MCP endpoint</label>
  <div class="agent-grant-create">
    <input class="field agent-grant-token" id="agent-mcp-url" value="{{.MCPURL}}" readonly spellcheck="false">
    <button class="btn btn-sec" id="agent-mcp-url-copy" type="button"><i class="ph ph-copy" aria-hidden="true"></i> Copy URL</button>
  </div>
  <label class="settings-label settings-note" for="agent-mcp-command">Claude Code</label>
  <div class="agent-grant-create">
    <input class="field agent-grant-token" id="agent-mcp-command" value="{{.ClaudeCommand}}" readonly spellcheck="false">
    <button class="btn btn-sec" id="agent-mcp-command-copy" type="button"><i class="ph ph-copy" aria-hidden="true"></i> Copy command</button>
  </div>
  <p class="settings-copy settings-note">Then run /mcp in Claude Code, choose Authenticate, and approve the connection in your browser.</p>
  <p class="settings-copy settings-note">Other MCP clients connect to the same URL and sign in the same way.</p>
  {{else}}<p class="settings-copy">MCP is not enabled on this instance.</p>{{end}}
  <div id="agent-grants-body" class="agent-grants-list"
       hx-get="/partials/agent-grants" hx-headers="{{.RefreshHeaders}}"
       hx-trigger="exhibit:agent-grants-changed from:body"
       hx-swap="innerHTML">{{template "agentGrantsPanelBody" .}}</div>
  {{if .MCPURL}}<form id="agent-grant-form" class="settings-form agent-grant-form" aria-describedby="agent-token-scope">
    <h4 class="settings-h4">Use a token instead</h4>
    <p class="settings-copy" id="agent-token-scope">Anyone with this token can search, create, read, and edit artifacts and widgets throughout your library, and read saved data. They cannot share or delete artifacts, or change saved data. Access lasts until you revoke it.</p>
    <label class="settings-label" for="agent-grant-label">Connection label</label>
    <div class="agent-grant-create">
      <input class="field" id="agent-grant-label" name="label" maxlength="100" placeholder="External agent" autocomplete="off">
      <button class="btn" id="agent-grant-issue" type="submit"><i class="ph ph-plus" aria-hidden="true"></i> Issue token</button>
    </div>
  </form>
  {{/* Browser-only output sits outside the swapped list. No plaintext token
       can be recovered from the store or rendered in a later page request. */}}
  <div class="agent-grant-issued" id="agent-grant-issued" hidden>
    <h4 class="settings-h4">Your connection token</h4>
    <p class="settings-copy">Copy this token now and keep it private. Exhibit cannot show it again.</p>
    <label class="settings-label" for="agent-grant-token">Token</label>
    <div class="agent-grant-create">
      <input class="field agent-grant-token" id="agent-grant-token" readonly autocomplete="off" spellcheck="false">
      <button class="btn btn-sec" id="agent-grant-copy" type="button"><i class="ph ph-copy" aria-hidden="true"></i> Copy token</button>
    </div>
    <p class="settings-copy settings-note">Add the remote connection to Claude Code:</p>
    <pre class="agent-grant-command"><code id="agent-grant-remote-command"></code></pre>
    <p class="settings-copy settings-note">Or configure another client as a remote MCP server:</p>
    <pre class="agent-grant-command"><code id="agent-grant-remote-config"></code></pre>
    <button class="btn btn-sec" id="agent-grant-dismiss" type="button">Done</button>
  </div>
  {{end}}
  <p class="settings-status" id="agent-grants-status" role="status" aria-live="polite" hidden></p>
</section>{{end}}

{{define "agentGrantsPanelBody"}}{{if .Grants}}
<div class="settings-table-wrap">
  <table class="settings-table agent-grants-table">
    <thead><tr><th scope="col">Label</th><th scope="col">Client</th><th scope="col">Created</th><th scope="col">Last used</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
    <tbody>{{range .Grants}}<tr>
      <td class="settings-name"><bdi>{{.Label}}</bdi></td><td><bdi>{{.Client}}</bdi></td><td>{{.Created}}</td><td>{{.LastUsed}}</td>
      <td class="settings-actions"><button class="btn btn-sec" type="button" data-action="revoke-agent-grant" data-grant-id="{{.ID}}" aria-label="Revoke {{.Label}}"><i class="ph ph-trash" aria-hidden="true"></i> Revoke</button></td>
    </tr>{{end}}</tbody>
  </table>
</div>
{{else}}<p class="muted text-sm">No agents connected yet.</p>{{end}}{{end}}
