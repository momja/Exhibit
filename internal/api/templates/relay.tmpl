{{define "relayConsent"}}<dialog class="relay-consent" data-relay-host-target="consent" data-action="cancel->relay-host#decline" aria-labelledby="relay-consent-title-{{.ID}}">
  <span class="experimental-label">Experimental connections</span>
  <h2 id="relay-consent-title-{{.ID}}">Allow this tool to connect?</h2>
  <p><strong>{{.Title}}</strong> wants Exhibit to contact <code data-relay-host-target="destination"></code>.</p>
  <p>Allow this tool to contact the services you’ve approved through Exhibit. A request can read data or make changes, as far as the API and any connected credential allow.</p>
  <p class="muted">This permission is for your account only. You can revoke it in Connections → Advanced settings.</p>
  <p role="alert" data-relay-host-target="error"></p>
  <div class="relay-dialog-actions"><button type="button" class="btn btn-sec" data-action="relay-host#decline" autofocus>Decline</button><button type="button" class="btn" data-relay-host-target="allow" data-action="relay-host#approve">Allow</button></div>
</dialog>{{end}}
