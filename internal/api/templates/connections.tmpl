{{define "connections"}}<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Connections — Exhibit</title><link rel="icon" type="image/svg+xml" href="{{.Favicon}}">{{template "pwaHead"}}
<link rel="stylesheet" href="{{asset "phosphor/regular.css"}}"><link rel="stylesheet" href="{{asset "gallery/tokens.css"}}"><link rel="stylesheet" href="{{asset "gallery/components.css"}}"><link rel="stylesheet" href="{{asset "gallery/settings.css"}}"><link rel="stylesheet" href="{{asset "gallery/connections.css"}}">
<script src="{{asset "htmx/htmx.min.js"}}"></script></head><body>
{{template "appHeader" .Header}}
<main class="connect-page" data-controller="connections" data-connections-artifact-id-value="{{if .Artifact}}{{.Artifact.ID}}{{end}}" data-connections-return-url-value="{{.BaseURL}}">
  <div class="connect-lede"><div><span class="experimental-label"><i class="ph ph-flask" aria-hidden="true"></i> Experimental</span><h2>{{if .Advanced}}Advanced connections{{else}}Your connected accounts{{end}}</h2><p>{{if .Advanced}}Custom connections are for people who know their service’s API and credential settings.{{else}}Choose which tools can use your accounts. Your account access always stays personal.{{end}}</p></div><a class="connect-account-link" href="/settings"><i class="ph ph-user-circle" aria-hidden="true"></i> Settings</a></div>
  {{if .Advanced}}<p class="connect-section-intro"><a href="{{.BaseURL}}">Back to connected accounts</a></p>{{end}}
  <p class="connect-feedback{{if .SetupFailed}} is-error{{end}}" role="status" aria-live="polite" data-connections-target="feedback">{{.Notice}}</p>
  {{if .Artifact}}<div class="connect-artifact-context"><i class="ph ph-frame-corners" aria-hidden="true"></i><div><span>Connections for</span><h3>{{.Artifact.Title}}</h3></div><a class="btn btn-sec" href="/artifacts/{{.Artifact.ID}}">Return to tool <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></div>{{end}}
  {{if .Enabled}}<div class="connect-layout">
    <section id="connection-workspace" hx-get="{{.WorkspaceURL}}" hx-trigger="exhibit:connections-changed from:body" hx-swap="innerHTML">{{template "connectionsBody" .}}</section>
    <aside class="connect-sidebar">{{template "connectionCreate" .}}<div class="connect-custody"><i class="ph ph-lock-key" aria-hidden="true"></i><div><strong>Your accounts stay yours.</strong><p>Sharing a tool never lets someone use your account. Each person connects their own.</p></div></div></aside>
  </div>{{else}}<section class="card connect-empty"><i class="ph ph-plugs" aria-hidden="true"></i><h3>Connections are switched off.</h3><p>Connections are experimental and must be enabled by the person running this Exhibit instance. Your saved data stays in place.</p></section>{{template "connectionSavedData" .}}{{end}}
</main>
<script>const TOKEN={{.Token}}; const READ_ONLY={{if .ReadOnly}}true{{else}}false{{end}};</script><script src="{{asset "gallery/api.js"}}"></script>{{template "componentScripts"}}
</body></html>{{end}}

{{define "connectionsBody"}}

{{if .Enabled}}
{{if .Requests}}<section class="card connect-section"><div class="connect-section-head"><h3>This tool needs an account</h3><span class="badge">{{len .Requests}}</span></div>{{range .Requests}}<div class="connect-request"><div><strong>{{.Provider}}</strong><p>{{.Reason}}</p><a class="btn" href="{{.URL}}">{{.Action}}</a></div><button class="btn btn-sec" type="button" data-action="connections#dismissRequest" data-request-id="{{.ID}}">Dismiss</button></div>{{end}}<p class="field-help">You choose the account and approve access. The agent cannot do this for you.</p></section>{{end}}
<section class="card connect-section"><div class="connect-section-head"><h3>Your accounts</h3><span class="connect-count">{{len .Connections}}</span></div>
{{if .Connections}}<div class="connection-list">{{range .Connections}}<article class="connection-item">
  <div class="connection-symbol"><i class="ph {{if eq .Provider "github"}}ph-github-logo{{else}}ph-key{{end}}" aria-hidden="true"></i></div>
  <div class="connection-description"><div class="connection-name"><h4>{{.Name}}</h4><span class="connection-status">{{if eq .Status "active"}}Connected{{else}}Reconnect needed{{end}}</span></div><p class="connection-provider">{{if eq .Kind "native"}}Custom connection{{else}}{{.Provider}}{{end}} · Only you can use this account</p><div class="connection-meta">{{.LastUsed}}</div>
  {{if or .ReconnectRecommended (ne .Status "active")}}<p class="connect-inline-error">Connect this account again to restore access. Your tools keep their existing permissions.</p>{{end}}
  <a class="btn btn-sec" href="{{if eq .Kind "native"}}{{$.AdvancedURL}}{{else}}{{$.BaseURL}}{{end}}&amp;reconnect={{.ID}}#connection-setup">Reconnect</a>
  {{if .Usage}}<div class="connection-usage">Used by {{range .Usage}}<a href="/connections?artifact={{.ArtifactID}}">{{.Title}}</a> {{end}}</div>{{end}}
  <details class="connection-details"{{if $.Advanced}} open{{end}}><summary>Connection details</summary>{{range .Origins}}<code>{{.}}</code>{{end}}{{if .DailyLimit}}<p class="field-help">{{.RequestsToday}} / {{.DailyLimit}} requests today</p>{{end}}{{if .CacheMinutes}}<p class="field-help">Reuse GET responses for {{.CacheMinutes}} minutes</p>{{end}}{{template "connectionDelivery" .Connection}}</details></div>
  <button type="button" class="connection-revoke" data-action="connections#revoke" data-connection-id="{{.ID}}" data-connection-name="{{.Name}}" aria-label="Disconnect {{.Name}}">Disconnect</button>
</article>{{end}}</div>{{else}}<div class="connect-empty"><i class="ph ph-plugs-connected" aria-hidden="true"></i><h4>No accounts connected yet.</h4><p>Connect an available service, then choose which tools can use your account.</p></div>{{end}}
</section>
{{if .Artifact}}
<section id="connection-access" class="card connect-section"><div class="connect-section-head"><h3>Access for this tool</h3><i class="ph ph-shield-check" aria-hidden="true"></i></div><p class="connect-section-intro">This tool can use the accounts you allow here on your behalf. People you share it with connect their own accounts.</p>
{{range .Grants}}<div class="connection-grant"><div><strong>{{.Connection.Name}}</strong><p>Allowed for your account only.</p></div><button class="btn btn-sec" type="button" data-action="connections#ungrant" data-connection-id="{{.Connection.ID}}">Remove access</button></div>{{end}}
{{if .Connections}}<form class="connect-form grant-form" data-action="submit->connections#grant" hx-get="/partials/connections?artifact={{.Artifact.ID}}&amp;preview=true" hx-trigger="change" hx-target="#grant-preview" hx-swap="innerHTML">
  <label for="grant-connection">Choose your account</label><select id="grant-connection" name="connection" required><option value="">Choose an account…</option>{{range .Connections}}<option value="{{.ID}}"{{if $.Preview}}{{if eq $.Preview.Connection.ID .ID}} selected{{end}}{{end}}{{if ne .Status "active"}} disabled{{end}}>{{.Name}}{{if ne .Status "active"}} · reconnect first{{end}}</option>{{end}}</select>
  {{if .IsOwner}}<label class="connect-check"><input type="checkbox" name="approve_origins" checked> <span>Allow this tool to contact this account’s service.</span></label>{{end}}
  <div id="grant-preview" class="grant-preview" aria-live="polite">{{template "connectionGrantPreview" .}}</div>
  <button type="submit" class="btn"><i class="ph ph-shield-check" aria-hidden="true"></i> Allow this tool</button>
</form>{{else}}<p class="muted">Connect your own account first, then allow this tool to use it.</p>{{end}}
</section>
{{template "connectionSavedData" .}}
{{if .Advanced}}
<section class="card connect-section"><div class="connect-section-head"><h3>Relay permissions</h3><span class="badge">For your account</span></div><p class="connect-section-intro">Let this artifact call approved APIs through Exhibit's server, including APIs that do not support browser requests.</p>
<form class="connect-form relay-form" data-action="submit->connections#saveRelay"><label class="connect-check"><input type="checkbox" name="allowed" {{if .Relay.Allowed}}checked{{end}}> <span><strong>Allow relay requests</strong><small>Requests to approved API origins, sent from this server's address. They can read or change data as far as the API and any connected credential allow.</small></span></label><button class="btn btn-sec" type="submit">Save permissions</button></form>
<div class="connect-origins"><span>Approved origins</span>{{range .Artifact.NetworkAllowlist}}<code>{{.}}</code>{{else}}<p class="muted">No origins approved yet.</p>{{end}}{{if .IsOwner}}<a href="/artifacts/{{.Artifact.ID}}/edit#security-panel">Edit network permissions <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>{{end}}</div>
<p class="field-help">Widgets read saved data and never use the relay. Public links and standalone render tabs cannot use your connection.</p>
</section>

{{if .SchedulesEnabled}}<section class="card connect-section"><div class="connect-section-head"><h3>Keep data fresh</h3><i class="ph ph-clock-clockwise" aria-hidden="true"></i></div><p class="connect-section-intro">Fetch an approved API into a localStorage key while the artifact is closed. The same connection grants and provider limits apply.</p>
{{range .Schedules}}<div class="schedule-item"><div><strong>{{.StateKey}}</strong><code>{{.URL}}</code><p>Every {{.IntervalSeconds}} seconds{{if .LastStatus}} · Last response {{.LastStatus}}{{end}}</p>{{if .LastError}}<p class="connect-inline-error">{{.LastError}}</p>{{end}}</div><button type="button" class="btn btn-sec" data-action="connections#deleteSchedule" data-schedule-id="{{.ID}}">Remove</button></div>{{end}}
<form class="connect-form" data-action="submit->connections#schedule"><label for="schedule-url">API URL</label><input type="url" id="schedule-url" name="url" placeholder="https://api.example.com/data" required><div class="connect-field-row"><div><label for="schedule-key">Save to localStorage key</label><input id="schedule-key" name="state_key" placeholder="accounts" required maxlength="1024"></div><div><label for="schedule-hours">Every</label><select id="schedule-hours" name="interval_hours"><option value="24">24 hours</option><option value="12">12 hours</option><option value="6">6 hours</option><option value="1">1 hour</option></select></div></div><p class="field-help">Starts at a random minute to spread provider traffic. Failed requests preserve the previous data.</p><button type="submit" class="btn btn-sec">Schedule refresh</button></form>
</section>{{end}}
<section class="card connect-section"><div class="connect-section-head"><h3>Recent relay activity</h3><span class="badge">Metadata only</span></div>{{if .Activity}}<div class="connect-activity"><table><thead><tr><th>Destination</th><th>Request</th><th>Result</th><th>Time</th></tr></thead><tbody>{{range .Activity}}<tr><td><code>{{.Origin}}</code></td><td>{{.Method}}</td><td>{{if eq .ErrorCode "credential_misuse_blocked"}}Credential misuse blocked{{else if eq .ErrorCode "needs_reconnect"}}Reconnect needed{{else if eq .ErrorCode "rate_limited"}}Rate limited{{else if eq .ErrorCode "refused"}}Refused{{else if eq .ErrorCode "upstream_error"}}Provider unavailable{{else if .Status}}{{.Status}}{{else}}Refused{{end}}{{if .Cached}} · cached{{end}}</td><td>{{.DurationMS}} ms</td></tr>{{end}}</tbody></table></div>{{else}}<p class="muted">No requests yet. Open the artifact to make its first request.</p>{{end}}<p class="field-help">Request bodies, responses, paths and query strings are never included in this activity log.</p></section>
{{if .IsOwner}}<div class="connect-portable"><i class="ph ph-package" aria-hidden="true"></i><div><strong>Take the app with you.</strong><p>Includes this tool’s saved data, which may contain connected account results. Account access is never included. Reconnect your own accounts on your machine.</p></div><a class="btn btn-sec" href="/api/artifacts/{{.Artifact.ID}}/relay-bundle" download>Download app</a></div>{{end}}

{{end}}
{{else}}<p class="connect-next-step">Open a tool’s Connections menu to choose which account it can use.</p>{{end}}
{{if not .Advanced}}<details class="connect-advanced"><summary>Advanced · Experimental</summary><p>Custom API credentials, server request settings, scheduled fetches and diagnostics.</p><a href="{{.AdvancedURL}}">Open advanced connections</a></details>{{end}}
{{else}}{{template "connectionSavedData" .}}{{end}}
{{end}}

{{define "connectionSavedData"}}{{if .Artifact}}<section class="card connect-section"><div class="connect-section-head"><h3>Saved results are separate</h3><i class="ph ph-database" aria-hidden="true"></i></div><p class="connect-section-intro">Disconnecting an account stops future access. Results this tool has already saved remain in its saved data.</p>
<p class="field-help">Public links and “Shared data” can show the owner’s saved results, including results from connected accounts. “Own data” keeps each signed-in person’s results separate. Saved-data exports and runnable app bundles include saved results; downloading the HTML file alone does not. None of these shares your account access.</p>
<p class="field-help">Review saved data before sharing or exporting. Clearing it does not change account permissions. Open pages may still hold copies.</p>{{if .CanClearData}}<button type="button" class="btn btn-sec" data-action="connections#clearData">Clear saved data</button>{{else}}<p class="muted">The tool’s owner can clear shared saved data.</p>{{end}}
</section>{{end}}{{end}}

{{define "connectionGrantPreview"}}{{if .Preview}}<strong>Allow {{.Artifact.Title}} to use {{.Preview.Connection.Name}}?</strong><p>This tool can read or change what this account’s permissions allow. Allow access only if you trust the tool.</p><p>Your account access stays personal. Saved results can be included when you share data or export them.</p><details><summary>Where requests go</summary>{{range .Preview.Connection.Origins}}<code>{{.}}</code> {{end}}<p>The tool can send results to its other approved destinations.</p>{{template "connectionDelivery" .Preview.Connection}}</details>{{else}}<span>Select an account to review access.</span>{{end}}{{end}}

{{define "connectionCreate"}}<section id="connection-setup" class="card connect-new"><div class="connect-section-head"><h3>{{if .Reconnect}}Reconnect {{.Reconnect.Name}}{{else if .Advanced}}Add a connection{{else}}Connect an account{{end}}</h3><i class="ph ph-plugs-connected" aria-hidden="true"></i></div>
{{if .Reconnect}}
<p class="connect-section-intro">This repairs your existing connection. Tools that already have access keep it.</p>
{{if eq .Reconnect.Kind "native"}}
{{if and .CustomEnabled .Advanced}}<p class="experimental-label">Advanced · Custom connection</p><form class="connect-form" data-action="submit->connections#repair" data-connection-id="{{.Reconnect.ID}}">
{{range .Reconnect.Origins}}<p class="field-help">Credential destination: <code>{{.}}</code></p>{{end}}
{{if eq .Reconnect.Provider "basic"}}<label for="repair-user">Username</label><input id="repair-user" name="username" autocomplete="off"><label for="repair-password">Password</label><input id="repair-password" name="password" type="password" autocomplete="new-password"><label for="repair-url">Credential URL (if originally used)</label><input id="repair-url" name="access_url" type="password" autocomplete="new-password"><p class="field-help">Use the same service and base path as the original connection.</p>{{else}}<label for="repair-secret">Replacement credential</label><input id="repair-secret" name="secret" type="password" required autocomplete="new-password">{{end}}
<button class="btn" type="submit">Save replacement credential</button></form>{{else if .CustomEnabled}}<a class="btn btn-sec" href="{{.AdvancedURL}}&amp;reconnect={{.Reconnect.ID}}#connection-setup">Open advanced reconnect</a>{{else}}<p class="muted">Custom connection setup is disabled. Ask the person running this instance to enable advanced custom connections before reconnecting.</p>{{end}}
{{else}}<button class="btn" type="button" data-action="connections#reconnect" data-connection-id="{{.Reconnect.ID}}" data-connection-kind="{{.Reconnect.Kind}}" data-provider="{{.Reconnect.Provider}}" data-connection-name="{{.Reconnect.Name}}">Continue to {{.Reconnect.Provider}}</button>{{end}}
<a href="{{.BaseURL}}">Cancel</a>
{{else}}
{{if .SetupProviders}}<form class="connect-form" data-connections-target="createForm" data-action="submit->connections#create">
<label for="connection-kind">{{if .Advanced}}Connection type{{else}}Service{{end}}</label><select id="connection-kind" name="recipe" data-action="change->connections#providerChanged" data-connections-target="provider">{{range .SetupProviders}}<option value="{{.ID}}"{{if eq $.SelectedProvider .ID}} selected{{end}}>{{.Name}}</option>{{end}}</select>
<label for="connection-name">Account label</label><input id="connection-name" name="name" placeholder="My account" required maxlength="100" autocomplete="off">
{{if and .Advanced .CustomEnabled}}<div data-connections-target="fields" data-recipes="api-key bearer basic"><label for="connection-origin">API origin</label><input type="url" id="connection-origin" name="origin" placeholder="https://api.example.com"><p class="field-help">The credential is sent only to this HTTPS origin.</p></div>
<div data-connections-target="fields" data-recipes="api-key"><label for="connection-header">Credential header</label><input id="connection-header" name="header" value="X-API-Key" placeholder="X-API-Key"></div>
<div data-connections-target="fields" data-recipes="api-key bearer"><label for="connection-secret">Secret</label><input type="password" id="connection-secret" name="secret" autocomplete="new-password" placeholder="Paste your API credential"></div>
<div data-connections-target="fields" data-recipes="basic"><label for="connection-access-url">Credential URL <span class="muted">optional</span></label><input type="password" id="connection-access-url" name="access_url" data-action="input->connections#basicURLChanged" autocomplete="new-password" placeholder="https://username:password@api.example.com/base"><p class="field-help">Paste an HTTPS URL with embedded credentials, or fill in the API origin, username and password instead. The URL stays encrypted. Artifact request paths are relative to its saved base path. Redeem any setup token yourself before pasting the resulting URL here.</p><label for="connection-user">Username</label><input id="connection-user" name="username" autocomplete="off"><label for="connection-password">Password</label><input type="password" id="connection-password" name="password" autocomplete="new-password"></div>
<div data-connections-target="fields" data-recipes="api-key bearer basic"><div class="connect-field-row"><div><label for="connection-daily-limit">Requests per UTC day</label><input type="number" id="connection-daily-limit" name="daily_limit" min="0" step="1" placeholder="Unlimited"></div><div><label for="connection-cache-minutes">Reuse responses for</label><input type="number" id="connection-cache-minutes" name="cache_minutes" min="0" max="525600" step="1" placeholder="Minutes"></div></div><p class="field-help">Optional limits apply across every artifact and device using this connection. A reused GET response spends no additional request. Blank or zero means no daily limit or no reuse.</p></div>
<p class="field-help">Custom credentials are sent only to the configured service. Choose narrower permissions at the provider to limit what tools can read or change.</p>{{end}}
<div data-connections-target="fields" data-recipes="github vendor"><p class="connect-provider-note">Continue to the service to choose your account. You’ll return here to finish setting up this tool.</p></div>
<p class="connect-inline-error" role="alert" data-connections-target="createError"></p><button class="btn connect-submit" type="submit" data-connections-target="createButton"><i class="ph ph-lock-key" aria-hidden="true"></i> Connect account</button>
</form>{{else}}<p class="muted">No services are available on this instance yet. The person running it chooses which experimental connections to enable.</p>{{end}}
{{if and .Advanced (not .CustomEnabled)}}<p class="field-help">Custom API connections are disabled by configuration.</p>{{end}}
{{end}}</section>{{end}}

{{define "connectionDelivery"}}{{if eq .DeliveryMode "forward"}}<p class="connect-provider-note">Forwarded by {{.Engine}}. Requests and responses pass through this vendor. Exhibit checks the initial destination but cannot inspect the vendor’s redirects or remove credentials echoed by the provider.{{if eq .Engine "composio"}} Composio may retain payloads for up to one year unless its Zero Data Retention terms cover the call.{{end}}</p>{{else if eq .Kind "vendor"}}<p class="field-help">{{.Engine}} manages consent and credentials. Exhibit sends API requests through its own network gate.</p>{{end}}{{end}}
