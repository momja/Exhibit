{{define "connections"}}<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Connections — Exhibit</title><link rel="icon" type="image/svg+xml" href="{{.Favicon}}">{{template "pwaHead"}}
<link rel="stylesheet" href="{{asset "phosphor/regular.css"}}"><link rel="stylesheet" href="{{asset "gallery/tokens.css"}}"><link rel="stylesheet" href="{{asset "gallery/components.css"}}"><link rel="stylesheet" href="{{asset "gallery/settings.css"}}"><link rel="stylesheet" href="{{asset "gallery/connections.css"}}">
<script src="{{asset "htmx/htmx.min.js"}}"></script></head><body>
{{template "settingsHeader" "Connections"}}
<main class="connect-page" data-controller="connections" data-connections-artifact-id-value="{{if .Artifact}}{{.Artifact.ID}}{{end}}">
  <div class="connect-lede"><div><span class="experimental-label"><i class="ph ph-flask" aria-hidden="true"></i> Experimental</span><h2>Your apps, connected.</h2><p>Give your artifacts access to the tools you use. You choose the account, the artifact, and where its data can go.</p></div><a class="connect-account-link" href="/profile"><i class="ph ph-user-circle" aria-hidden="true"></i> Your account</a></div>
  <p class="connect-feedback" role="status" aria-live="polite" data-connections-target="feedback"></p>
  {{if .Enabled}}<div class="connect-layout">
    <section id="connection-workspace" hx-get="/partials/connections{{if .Artifact}}?artifact={{.Artifact.ID}}{{end}}" hx-trigger="exhibit:connections-changed from:body" hx-swap="innerHTML">{{template "connectionsBody" .}}</section>
    <aside class="connect-sidebar">{{template "connectionCreate" .}}<div class="connect-custody"><i class="ph ph-lock-key" aria-hidden="true"></i><div><strong>Your credentials stay in Exhibit.</strong><p>Stored encrypted. Added only to approved API requests. Artifacts, agents and exported files never receive your secret.</p></div></div></aside>
  </div>{{else}}<section class="card connect-empty"><i class="ph ph-plugs" aria-hidden="true"></i><h3>Connections are switched off.</h3><p>The operator can enable the experimental relay and connectors for this instance. Saved connection data keeps its protection.</p></section>{{if .Artifact}}<section id="connection-workspace" hx-get="/partials/connections?artifact={{.Artifact.ID}}" hx-trigger="exhibit:connections-changed from:body" hx-swap="innerHTML">{{template "connectionsBody" .}}</section>{{end}}{{end}}
</main>
<script>const TOKEN={{.Token}}; const READ_ONLY={{if .ReadOnly}}true{{else}}false{{end}};</script><script src="{{asset "gallery/api.js"}}"></script>{{template "componentScripts"}}
</body></html>{{end}}

{{define "connectionsBody"}}
{{if .Artifact}}<div class="connect-artifact-context"><i class="ph ph-frame-corners" aria-hidden="true"></i><div><span>Configuring this artifact</span><h3>{{.Artifact.Title}}</h3></div><a class="btn btn-sec" href="/artifacts/{{.Artifact.ID}}">Open artifact <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></div>{{end}}
{{if .Enabled}}
{{if .Warnings}}<aside class="connect-warning"><i class="ph ph-warning-circle" aria-hidden="true"></i><div>{{range .Warnings}}<p>{{.Message}}</p>{{end}}</div></aside>{{end}}
{{if .Requests}}<section class="card connect-section"><div class="connect-section-head"><h3>Requested by your agent</h3><span class="badge">{{len .Requests}}</span></div>{{range .Requests}}<div class="connect-request"><div><strong>{{.Provider}}</strong><p>{{.Reason}}</p></div><button class="btn btn-sec" type="button" data-action="connections#dismissRequest" data-request-id="{{.ID}}">Dismiss</button></div>{{end}}<p class="muted text-sm">Connect the account here, then grant it below. The agent cannot approve access for you.</p></section>{{end}}
<section class="card connect-section"><div class="connect-section-head"><h3>Saved connections</h3><span class="connect-count">{{len .Connections}}</span></div>
{{if .Connections}}<div class="connection-list">{{range .Connections}}<article class="connection-item">
  <div class="connection-symbol {{if eq .Sensitivity "financial"}}connection-financial{{end}}"><i class="ph {{if eq .Provider "simplefin"}}ph-bank{{else if eq .Provider "github"}}ph-github-logo{{else}}ph-key{{end}}" aria-hidden="true"></i></div>
  <div class="connection-description"><div class="connection-name"><h4>{{.Name}}</h4><span class="connection-status">{{.Status}}</span></div><p class="connection-provider">{{.Provider}}{{range .Capabilities}} · {{.}}{{end}}</p>{{range .Origins}}<code>{{.}}</code>{{end}}<div class="connection-meta">{{.LastUsed}}{{if .DailyLimit}} · {{.RequestsToday}} / {{.DailyLimit}} requests today{{end}}</div>{{if .Usage}}<div class="connection-usage">Used by {{range .Usage}}<a href="/connections?artifact={{.ArtifactID}}">{{.Title}}</a> {{end}}</div>{{end}}</div>
  <button type="button" class="connection-revoke" data-action="connections#revoke" data-connection-id="{{.ID}}" data-connection-name="{{.Name}}" aria-label="Revoke {{.Name}}">Revoke</button>
</article>{{end}}</div>{{else}}<div class="connect-empty"><i class="ph ph-plugs-connected" aria-hidden="true"></i><h4>Make your first connection.</h4><p>Connect an account using the form beside this list.<br>Then choose which artifacts can use it.</p></div>{{end}}
</section>
{{if .Artifact}}
<section class="card connect-section"><div class="connect-section-head"><h3>Access for this artifact</h3><i class="ph ph-shield-check" aria-hidden="true"></i></div><p class="connect-section-intro">Connections belong to you. People you share the artifact with connect their own accounts unless you explicitly choose otherwise.</p>
{{range .Grants}}<div class="connection-grant"><div><strong>{{.Connection.Name}}</strong><p>{{.Consent}}</p>{{if .ShareWithRecipients}}<span class="badge">Shared with recipients</span>{{end}}{{if .Connection.Endpoint}}<code>fetch('{{.Connection.Endpoint}}')</code>{{end}}</div><button class="btn btn-sec" type="button" data-action="connections#ungrant" data-connection-id="{{.Connection.ID}}">Remove access</button></div>{{end}}
{{if .Connections}}<form class="connect-form grant-form" data-action="submit->connections#grant" hx-get="/partials/connections?artifact={{.Artifact.ID}}&amp;preview=true" hx-trigger="change" hx-target="#grant-preview" hx-swap="innerHTML">
  <label for="grant-connection">Allow a saved connection</label><select id="grant-connection" name="connection" required><option value="">Choose a connection…</option>{{range .Connections}}<option value="{{.ID}}">{{.Name}} · {{.Provider}}</option>{{end}}</select>
  <label for="grant-egress">Additional destinations for data <span class="muted">optional</span></label><textarea id="grant-egress" name="egress" rows="2" placeholder="https://another-api.example.com"></textarea><p class="field-help">Leave blank to keep data at the connection's own API. Enter HTTPS origins separated by commas. The artifact's origin approvals still apply.</p>
  <label class="connect-check"><input type="checkbox" name="sharing"> <span>Let recipients use my connection and its data.</span></label>
  {{if .IsOwner}}<label class="connect-check"><input type="checkbox" name="approve_origins" checked> <span>Approve this connection's API origins for the artifact.</span></label>{{end}}
  <div id="grant-preview" class="grant-preview" aria-live="polite">{{template "connectionGrantPreview" .}}</div>
  <button type="submit" class="btn"><i class="ph ph-shield-check" aria-hidden="true"></i> Grant access</button>
</form>{{else}}<p class="muted">Create a connection first, then grant it to this artifact.</p>{{end}}
</section>
<section class="card connect-section"><div class="connect-section-head"><h3>Relay permissions</h3><span class="badge">For your account</span></div><p class="connect-section-intro">Let this artifact call approved APIs through Exhibit's server, including APIs that do not support browser requests.</p>
<form class="connect-form relay-form" data-action="submit->connections#saveRelay"><label class="connect-check"><input type="checkbox" name="reads" {{if .Relay.Reads}}checked{{end}}> <span><strong>Allow reads</strong><small>GET and HEAD requests from this server's address.</small></span></label><label class="connect-check"><input type="checkbox" name="writes" {{if .Relay.Writes}}checked{{end}}> <span><strong>Allow writes and changes</strong><small>POST, PUT, PATCH and DELETE. Requires reads.</small></span></label><button class="btn btn-sec" type="submit">Save permissions</button></form>
<div class="connect-origins"><span>Approved origins</span>{{range .Artifact.NetworkAllowlist}}<code>{{.}}</code>{{else}}<p class="muted">No origins approved yet.</p>{{end}}{{if .IsOwner}}<a href="/artifacts/{{.Artifact.ID}}/edit#network">Edit network permissions <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>{{end}}</div>
<p class="field-help">Widgets read saved data and never use the relay. Public links and standalone render tabs cannot use your connection.</p>
</section>
{{template "connectionDataProtection" .}}
{{if .SchedulesEnabled}}<section class="card connect-section"><div class="connect-section-head"><h3>Keep data fresh</h3><i class="ph ph-clock-clockwise" aria-hidden="true"></i></div><p class="connect-section-intro">Fetch an approved API into a localStorage key while the artifact is closed. The same connection grants and provider limits apply.</p>
{{range .Schedules}}<div class="schedule-item"><div><strong>{{.StateKey}}</strong><code>{{.URL}}</code><p>Every {{.IntervalSeconds}} seconds{{if .LastStatus}} · Last response {{.LastStatus}}{{end}}</p>{{if .LastError}}<p class="connect-inline-error">{{.LastError}}</p>{{end}}</div><button type="button" class="btn btn-sec" data-action="connections#deleteSchedule" data-schedule-id="{{.ID}}">Remove</button></div>{{end}}
<form class="connect-form" data-action="submit->connections#schedule"><label for="schedule-url">API URL</label><input type="url" id="schedule-url" name="url" placeholder="https://api.example.com/data" required><div class="connect-field-row"><div><label for="schedule-key">Save to localStorage key</label><input id="schedule-key" name="state_key" placeholder="accounts" required maxlength="1024"></div><div><label for="schedule-hours">Every</label><select id="schedule-hours" name="interval_hours"><option value="24">24 hours</option><option value="12">12 hours</option><option value="6">6 hours</option><option value="1">1 hour</option></select></div></div><p class="field-help">Starts at a random minute to spread provider traffic. Failed requests preserve the previous data.</p><button type="submit" class="btn btn-sec">Schedule refresh</button></form>
</section>{{end}}
<section class="card connect-section"><div class="connect-section-head"><h3>Recent relay activity</h3><span class="badge">Metadata only</span></div>{{if .Activity}}<div class="connect-activity"><table><thead><tr><th>Destination</th><th>Request</th><th>Result</th><th>Time</th></tr></thead><tbody>{{range .Activity}}<tr><td><code>{{.Origin}}</code></td><td>{{.Method}}</td><td>{{if .ErrorCode}}Credential misuse blocked{{else if .Status}}{{.Status}}{{else}}Refused{{end}}{{if .Cached}} · cached{{end}}</td><td>{{.DurationMS}} ms</td></tr>{{end}}</tbody></table></div>{{else}}<p class="muted">No requests yet. Open the artifact to make its first request.</p>{{end}}<p class="field-help">Request bodies, responses, paths and query strings are never included in this activity log.</p></section>
{{if .IsOwner}}<div class="connect-portable"><i class="ph ph-package" aria-hidden="true"></i><div><strong>Take the app with you.</strong><p>Export a runnable bundle with a local relay. Reconnect your accounts on your own machine.</p></div><a class="btn btn-sec" href="/api/artifacts/{{.Artifact.ID}}/relay-bundle" download>Download app</a></div>{{end}}
{{else}}<div class="connect-next-step"><i class="ph ph-frame-corners" aria-hidden="true"></i><p>To let an artifact use a connection, open its <strong>Connections &amp; relay</strong> menu.</p></div>{{end}}
{{else}}{{template "connectionDataProtection" .}}{{end}}
{{end}}

{{define "connectionDataProtection"}}{{if .DataPolicies}}<section class="card connect-section"><div class="connect-section-head"><h3>Saved data protection</h3><i class="ph ph-lock-key" aria-hidden="true"></i></div><p class="connect-section-intro">Connection data stays restricted to its approved destinations after you remove access or revoke a connection.</p>
{{range .DataPolicies}}<div class="connect-origins"><span>Allowed destinations</span>{{range .Origins}}<code>{{.}}</code>{{end}}</div>{{end}}
<p class="field-help">Clear saved data to release old restrictions. Active connection grants continue to apply. Open pages may still hold data.</p>{{if .CanClearData}}<button type="button" class="btn btn-sec" data-action="connections#clearData">Clear saved data and old restrictions</button>{{else}}<p class="muted">The artifact owner can clear shared saved data.</p>{{end}}
</section>{{end}}{{end}}

{{define "connectionGrantPreview"}}{{if .Preview}}<strong>What you are allowing</strong><p>This artifact can {{.Preview.ReadText}} using <strong>{{.Preview.Connection.Name}}</strong>.</p><p>Can send data to: {{range .Preview.Connection.Origins}}<code>{{.}}</code> {{end}}{{range .Preview.Destinations}}<code>{{.}}</code> {{else}}<span>and nowhere else.</span>{{end}}</p>{{if .Preview.Sharing}}<p>Recipients may use your connection and receive its data.</p>{{else}}<p>Your connection is private to your account.</p>{{end}}{{else}}<span>Select a connection to review exactly what you are allowing.</span>{{end}}{{end}}

{{define "connectionCreate"}}<section class="card connect-new"><div class="connect-section-head"><h3>Add a connection</h3><i class="ph ph-plus-circle" aria-hidden="true"></i></div>{{if .Providers}}<form class="connect-form" data-connections-target="createForm" data-action="submit->connections#create">
<label for="connection-kind">Connection type</label><select id="connection-kind" name="recipe" data-action="change->connections#providerChanged" data-connections-target="provider">{{range .Providers}}<option value="{{.ID}}" {{if not .Enabled}}disabled{{end}}>{{.Name}}{{if not .Enabled}} · unavailable{{end}}</option>{{end}}</select>
<label for="connection-name">Name</label><input id="connection-name" name="name" placeholder="My account" required maxlength="100" autocomplete="off">
<div data-connections-target="fields" data-recipes="api-key bearer basic"><label for="connection-origin">API origin</label><input type="url" id="connection-origin" name="origin" placeholder="https://api.example.com"><p class="field-help">The credential is sent only to this HTTPS origin.</p></div>
<div data-connections-target="fields" data-recipes="api-key"><label for="connection-header">Credential header</label><input id="connection-header" name="header" value="X-API-Key" placeholder="X-API-Key"></div>
<div data-connections-target="fields" data-recipes="api-key bearer"><label for="connection-secret">Secret</label><input type="password" id="connection-secret" name="secret" autocomplete="new-password" placeholder="Paste your API credential"></div>
<div data-connections-target="fields" data-recipes="basic"><label for="connection-user">Username</label><input id="connection-user" name="username" autocomplete="off"><label for="connection-password">Password</label><input type="password" id="connection-password" name="password" autocomplete="new-password"></div>
<div data-connections-target="fields" data-recipes="simplefin"><label for="connection-setup">SimpleFIN setup token</label><input type="password" id="connection-setup" name="setup_token" autocomplete="new-password" placeholder="Paste your one-time setup token"><p class="field-help">Exhibit claims the token securely. Never paste setup tokens or access URLs into an artifact or an agent conversation.</p><div class="connect-provider-note"><i class="ph ph-bank" aria-hidden="true"></i><p>Read accounts and transactions. Cached for one hour, with a maximum of 24 API requests per day.</p></div></div>
<div data-connections-target="fields" data-recipes="github"><p class="connect-provider-note">Continue to GitHub to choose your account. Exhibit will store the resulting credential securely.</p></div>
<div data-connections-target="fields" data-recipes="nango"><label for="connection-vendor-provider">Approved provider</label><select id="connection-vendor-provider" name="vendor_provider">{{range .VendorProviders}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><p class="field-help">Continue to the provider to choose your account. This page updates automatically after you finish consent.</p></div>
<div data-connections-target="fields" data-recipes="api-key bearer basic"><label class="connect-check"><input type="checkbox" name="allow_writes"><span>Allow this credential to make API changes.</span></label></div>
<p class="connect-inline-error" role="alert" data-connections-target="createError"></p><button class="btn connect-submit" type="submit" data-connections-target="createButton"><i class="ph ph-lock-key" aria-hidden="true"></i> Save connection</button>
</form>{{else}}<p class="muted">The operator has enabled the relay. Enable connectors to add accounts here.</p>{{end}}</section>{{end}}
