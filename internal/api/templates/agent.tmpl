{{/* Agent chat surface (Exh-jlbt): a build/modify-with-AI chat on the left, a
     live sandboxed preview of the session's artifact on the right. Data:
     agentPageData (agentui.go). ?artifact=<id> opens the page in modify mode
     bound to that artifact. Streaming arrives over SSE from the session's Pi
     sidecar.

     The chat is always a new conversation: no session exists until the first
     message, and that message starts one — however many conversations the
     artifact has kept. An earlier one is continued only from the History pane
     (agentResume), by choosing it; nothing on this page resumes one on its own,
     and a redesign of it must not. */}}
{{define "agent"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" type="image/svg+xml" href="{{.Favicon}}">
{{template "pwaHead"}}
<title>Agent — Exhibit</title>
<link rel="stylesheet" href="/assets/phosphor/regular.css">
<link rel="stylesheet" href="/assets/gallery/tokens.css">
{{/* components.css joins the other pages' layering here (tokens → components →
     page sheet) because the preview pane now renders the shared cardWidget
     component (av-fafu). agent.css still loads last, so its own .btn/.spacer
     definitions keep winning. */}}
<link rel="stylesheet" href="/assets/gallery/components.css">
<link rel="stylesheet" href="/assets/gallery/agent.css">
<script src="/assets/htmx/htmx.min.js"></script>
</head>
<body>
<header>
  <a href="{{.BackURL}}">←<span class="lbl"> Back</span></a>
  <h1><i class="ph ph-robot"></i> Agent</h1>
  {{/* Platform mode renders no key control at all (av-siqf) — not a disabled
       one. The instance supplies the credential, and which provider and model
       it runs is not something this page reports. */}}
  {{if .BYOK}}<button class="key-btn" id="key-btn" onclick="openKeyModal()"><i class="ph ph-key"></i> <span id="key-btn-label">API key</span></button>{{end}}
</header>
{{if not .AgentEnabled}}<div class="banner-err">Agent support is disabled: the <code>pi</code> binary was not found on this server.</div>{{end}}
<div class="pane-switch">
  <div class="pane-tabs" role="tablist" aria-label="Chat or preview">
    <button type="button" class="pane-tab" id="tab-chat" role="tab" aria-selected="true" aria-controls="pane-chat" onclick="showPane('chat')"><i class="ph ph-chat-circle"></i> Chat</button>
    <button type="button" class="pane-tab" id="tab-preview" role="tab" aria-selected="false" aria-controls="pane-preview" onclick="showPane('preview')"><i class="ph ph-monitor"></i> Preview <span class="dot" aria-hidden="true"></span></button>
  </div>
</div>
<div class="layout" id="agent-layout">
  <div class="chat" id="pane-chat">
    {{/* The chat's own controls. History lists the conversations kept with this
         artifact (av-y7td) in a pane that takes the place of the messages and
         the composer while it is open — a conversation you are only reading
         must not sit above a box that would talk to the live one. The pane's
         contents are server-rendered fragments, swapped into #history; the
         button stays hidden until the page knows which artifact it is about. */}}
    <div class="chat-bar">
      <button type="button" class="hist-btn" id="history-btn" hidden
              hx-get="/partials/agent-history" hx-vals='js:{artifact: previewArtifactId()}'
              hx-target="#history" hx-swap="innerHTML" onclick="openHistory()"><i class="ph ph-clock-counter-clockwise"></i> History</button>
    </div>
    <template id="agent-message-template">{{template "agentMessage" ""}}</template>
    <div id="messages"></div>
    <div id="history"></div>
    <div class="composer">
      <div id="agent-network-warnings" hx-get="/partials/network-warnings"
           hx-trigger="load, exhibit:artifact-saved from:body"
           hx-vals='js:{artifact: previewArtifactId()}' hx-swap="innerHTML" hx-sync="this:replace"></div>
      <div id="agent-connection-requests" hx-get="/partials/agent-connection-requests"
           hx-trigger="load, exhibit:artifact-saved from:body, exhibit:connection-requested from:body"
           hx-vals='js:{artifact: previewArtifactId()}' hx-swap="innerHTML" hx-sync="this:replace"></div>
      <div id="question-load-error" role="status" hidden>Could not load the questions. <button type="button" id="question-retry">Try again</button></div>
      <button type="button" class="pv-nudge" id="pv-nudge" hidden onclick="showPane('preview')"><i class="ph ph-check-circle"></i> Preview updated — tap Preview to view</button>
      <div id="snippet-chips"></div>
      <div class="compose-row">
        <textarea id="input" rows="1" aria-label="Message the agent" placeholder="Describe the tool to build…"></textarea>
        <button type="button" class="btn" id="send-btn" onclick="send()" aria-label="Send message" title="Send message" disabled><i class="ph ph-paper-plane-right" aria-hidden="true"></i></button>
        <button type="button" class="btn btn-stop" id="stop-btn" onclick="stopAgent()" aria-label="Stop agent" title="Stop agent" style="display:none"><i class="ph ph-stop" aria-hidden="true"></i></button>
      </div>
      <div id="hint">Enter to send · Shift+Enter for a new line · Ctrl+Shift+S to snippet an element from the preview</div>
    </div>
  </div>
  <div class="pane-resizer" id="agent-pane-resizer" role="separator" tabindex="0"
       aria-label="Resize agent chat" aria-orientation="vertical" aria-controls="pane-chat"
       aria-valuemin="280" aria-valuenow="460"></div>
  {{/* The pane's contents are a server-rendered fragment (agentPreview), and
       every agent save re-fetches it: the artifact-saved hook fires the
       exhibit:artifact-saved event on <body>, htmx GETs the fragment for the
       session's current artifact, and swaps it in. The wiring lives here, in
       markup, so agent.js never rebuilds markup the template already owns. */}}
  <div class="preview" id="pane-preview"
       hx-get="/partials/agent-preview"
       hx-trigger="exhibit:artifact-saved from:body"
       hx-vals='js:{artifact: previewArtifactId()}'
       hx-swap="innerHTML">{{template "agentPreview" .Preview}}</div>
</div>

{{/* The same runtime network-permission dialog the detail page hosts
     (av-6xvs). This pane embeds the same render document behind the same
     sandbox and sits on the same app origin, so it has the trusted chrome the
     prompt needs — it simply never had the prompt. */}}
{{template "networkPrompt"}}
{{if .BYOK}}
<div id="key-modal" class="modal-overlay" hidden>
  <div class="modal" role="dialog" aria-modal="true">
    <h2>Agent API key</h2>
    <p class="note">Bring your own key. It is sent to your Exhibit server once, encrypted there at rest, and used only by the server-side agent — this page never sees it again.</p>
    <div class="current-key" id="current-key" hidden></div>
    <label for="key-provider">Provider</label>
    <select id="key-provider" onchange="providerChanged()">
      <option value="anthropic">Anthropic</option>
      <option value="openai">OpenAI</option>
      <option value="google">Google Gemini</option>
      <option value="openrouter">OpenRouter</option>
      <option value="opencode-go">OpenCode Go</option>
      {{if .MockEnabled}}<option value="exhibit-mock">Exhibit Mock (testing)</option>{{end}}
    </select>
    <label for="key-model">Model</label>
    <input type="text" id="key-model" list="model-suggestions" placeholder="e.g. claude-sonnet-4-5">
    <datalist id="model-suggestions"></datalist>
    <label for="key-secret">API key</label>
    <input type="password" id="key-secret" placeholder="sk-…" autocomplete="off">
    <div id="key-error" class="modal-error" hidden></div>
    <div class="modal-actions">
      <button type="button" class="btn btn-danger" id="key-delete" onclick="deleteKey()" hidden><i class="ph ph-trash"></i></button>
      <span class="spacer"></span>
      <button type="button" class="btn btn-sec" onclick="closeKeyModal()">Cancel</button>
      <button type="button" class="btn" onclick="saveKey()"><i class="ph ph-check"></i> Save</button>
    </div>
  </div>
</div>
{{end}}
<script>
const TOKEN = {{.Token}};
{{/* READ_ONLY and TOKEN are one decision, made server-side per request
     (av-5imk, pagecredential.go): a session-authenticated browser gets no
     token because its cookie already authenticates it, an anonymous visitor
     gets no token and READ_ONLY, and a single-user instance with no identity
     provider gets the static token it has always had. api.js is what spends
     the result — page scripts never build an Authorization header. Literal
     template text for the boolean, matching the other bootstrap flags:
     html/template's JS escaper pads a {{value}} boolean with spaces. */ -}}
const READ_ONLY = {{if .ReadOnly}}true{{else}}false{{end}};
{{/* BYOK false is platform mode (av-siqf): the key markup above is absent, so
     agent.js must not reach for it or ask the key route about it. */ -}}
const BYOK = {{if .BYOK}}true{{else}}false{{end}};
let artifact = {{.ArtifactJSON}};   // {id,title} when editing, else null
</script>
<script src="/assets/gallery/api.js"></script>
<script src="/assets/gallery/state-api.js"></script>
<script src="/assets/gallery/network-prompt.js"></script>
{{/* components.js carries the widget-tile health watcher (av-fafu); the
     preview pane renders a tile, so it needs it like the gallery does. */}}
<script src="/assets/gallery/components.js"></script>
<script type="module" src="/assets/gallery/agent.js"></script>
{{template "directOpenPrompt" .DirectOpen}}
<script type="module" src="/assets/gallery/direct-open.js"></script>
<script type="module" src="/assets/gallery/agent-resize.js"></script>
<script type="module" src="/assets/gallery/agent-questions.js"></script>
<script type="module" src="/assets/gallery/message-actions.js"></script>
{{template "componentScripts"}}
</body>
</html>{{end}}

{{/* agentPreview is the preview pane's contents: the bar (title, links,
     snippet button) and the frame well. It is rendered both by the agent page
     above and by GET /partials/agent-preview (agentui.go), so the two states
     of this pane — "no artifact yet" and "showing artifact X" — have exactly
     one definition.

     Consequences worth knowing before editing:
     - The <iframe> is created by the swap, not reused: FrameURL carries a
       fresh cache-busting stamp per render, which is what makes the preview
       show the agent's new body (the render doc is Cache-Control: no-store,
       but the src still has to change for the browser to refetch it). Page JS
       must therefore look #pv-frame up on each use rather than caching it.
     - Absent an artifact the frame well holds the empty state instead of a
       src-less iframe, so there is never an iframe pointed at nothing.
     Data: agentPreviewData (agentui.go). */}}
{{define "agentPreview"}}<div class="preview-bar">
      <span class="title" id="pv-title">{{if .HasArtifact}}{{.Title}}{{else}}Preview{{end}}</span>
      {{if .HasArtifact}}<button type="button" id="pv-open" class="preview-open" data-direct-open-artifact="{{.ID}}" data-direct-open-url="{{.OpenURL}}" aria-label="Open in new tab" title="{{if .ConnectionProtected}}Connected data must stay inside Exhibit, where its data destinations are enforced.{{else}}Open in new tab{{end}}"{{if .ConnectionProtected}} disabled{{end}}><span class="lbl">{{if .ConnectionProtected}}Preview only{{else}}Open{{end}} </span><i class="ph ph-arrow-square-out" aria-hidden="true"></i></button>
      <a id="pv-detail" href="{{.DetailURL}}">Details</a>{{end}}
      <span class="spacer"></span>
      <button class="snip-btn" id="snip-btn"{{if not .HasArtifact}} disabled hidden{{end}} onclick="toggleSnippet()"><i class="ph ph-scissors"></i> Snippet<span class="snip-more">an element</span> <span class="kbd">Ctrl+Shift+S</span></button>
    </div>
    {{/* The artifact's gallery tile (av-fafu), rendered by the same cardWidget
         partial the library uses so what the agent sees here is what the
         library will show. Before any set_widget call this is the default
         tile — which is exactly the "no widget yet" state, so it needs no
         empty case of its own. */}}
    {{if .HasArtifact}}<div class="pv-widget">{{template "cardWidget" .Widget}}<span class="pv-widget-label">Gallery widget</span></div>{{end}}
    <div id="frame-wrap"{{if .FramePolicyEnabled}} data-controller="relay-host" data-relay-host-artifact-id-value="{{.ID}}" data-relay-host-frame-selector-value="#pv-frame" data-relay-host-policy-value="{{.RelayPolicy}}"{{end}}>
      {{if .FramePolicyEnabled}}<template data-relay-host-target="framePolicy"><meta http-equiv="Content-Security-Policy" content="{{.RelayFramePolicy}}"></template>{{end}}
      {{if .HasArtifact}}<iframe id="pv-frame" {{if .FramePolicyEnabled}}data-relay-src{{else}}src{{end}}="{{.FrameURL}}" sandbox="allow-scripts allow-forms" allow="clipboard-read; clipboard-write"></iframe>{{else}}<div id="empty-preview"><i class="ph ph-frame-corners"></i><span>Your tool will appear here.</span></div>{{end}}
      {{if .RelayEnabled}}{{template "relayConsent" .}}{{end}}
    </div>{{end}}

{{/* agentHistory is the history pane's list: every conversation kept with the
     artifact, newest first, each saying what it was about, when, and which
     version of the artifact it was last working against. Rendered by
     GET /partials/agent-history (transcripts.go) into #history, which is the
     only place it exists. Data: agentHistoryData. */}}
{{define "agentHistory"}}<div class="history-bar">
  <button type="button" class="history-back" onclick="closeHistory()"><i class="ph ph-arrow-left"></i> Chat</button>
  <h2>Previous conversations</h2>
</div>
{{if .Items}}<ul class="history-list">
  {{range .Items}}<li><button type="button" class="history-item"
      hx-get="/partials/agent-transcript?artifact={{.ArtifactID | urlquery}}&amp;session={{.SessionID | urlquery}}"
      hx-target="#history" hx-swap="innerHTML">
    <span class="history-item-title">{{.Title}}</span>
    <span class="history-item-meta">{{template "conversationMeta" .}}</span>
  </button></li>{{end}}
</ul>{{else}}<p class="history-empty">No earlier conversations about this artifact yet. Each one you have with the agent is kept here.</p>{{end}}{{end}}

{{/* agentTranscript is one stored conversation, read-only: the same bubbles and
     tool chips the live chat draws, from the projection of what was said
     (agent.Messages) — never the stored session file. Data: agentTranscriptData. */}}
{{define "agentTranscript"}}<div class="history-bar">
  <button type="button" class="history-back"
          hx-get="/partials/agent-history?artifact={{.ArtifactID | urlquery}}" hx-target="#history" hx-swap="innerHTML"><i class="ph ph-arrow-left"></i> Conversations</button>
</div>
<div class="history-head">
  <h2 class="history-title">{{.Title}}</h2>
  <p class="history-meta">{{template "conversationMeta" .}}</p>
</div>
<div class="history-messages" id="history-messages">
  {{range .Messages}}{{if eq .Role "questions"}}{{template "agentQuestionHistory" .Questions}}{{else if eq .Role "tool"}}<div class="tool-chip {{if .Failed}}fail{{else}}done{{end}}"><i class="ph {{if .Failed}}ph-x-circle{{else}}ph-check-circle{{end}}"></i> {{.Text}}</div>{{else if eq .Role "assistant"}}{{template "agentMessage" .Text}}{{else}}<div class="msg {{.Role}}">{{.Text}}{{if .Images}}<span class="history-images">{{.Images}} image{{if ne .Images 1}}s{{end}} attached</span>{{end}}</div>{{end}}{{else}}<p class="history-empty">Nothing was said in this conversation.</p>{{end}}
</div>
{{template "agentResume" .}}{{end}}

{{/* agentResume is how a stored conversation is continued — and the one place a
     person decides what happens to the artifact when they do (av-b4yh).

     The conversation was last working against one version of the artifact and
     the artifact may have moved on. If it has, continuing offers two things and
     states what each costs. Rolling back is the primary action: it puts the
     artifact's code and saved data back as that version left them, recorded as
     a new version so nothing is lost, and the click on a button that says so is
     the confirmation — nothing changes before it. Continuing without rolling
     back is the escape: a plain secondary button, never the primary one, which
     leaves the artifact alone and starts the agent from it as it is, told that
     it may have changed.

     Before choosing, the person can look at the version they would return to:
     "View vN" swaps it, running and with the data it had, into the preview pane
     beside this card (the versionViewer partial). It is a look and nothing
     more — nothing done in it is saved — and the card's own buttons remain the
     only things that change the artifact.

     Everything else is a note, not a missing button: a conversation kept before
     they could be continued says so, and so does an instance with no agent.
     Data: agentTranscriptData; agent.js (resumeConversation) does the rest. */}}
{{define "agentResume"}}{{if not .Resumable}}<p class="resume-note">This conversation was kept before conversations could be continued, so it can only be read.</p>
{{else if not .AgentEnabled}}<p class="resume-note">Agent support is off on this server, so conversations can only be read.</p>
{{else if or .Current (eq .VersionSeq 0)}}<div class="resume-card" id="resume-card">
  <button type="button" class="btn" data-resume="{{.SessionID}}" data-rollback="0"><i class="ph ph-chat-circle"></i> Continue this conversation</button>
  <p class="resume-status" id="resume-status" role="status" aria-live="polite"></p>
</div>
{{else}}<div class="resume-card" id="resume-card">
  <p class="resume-lede">This conversation was last working against <strong>v{{.VersionSeq}}</strong>. The artifact is now at <strong>v{{.HeadSeq}}</strong>.</p>
  <button type="button" class="resume-view"
          hx-get="/partials/version-viewer?artifact={{.ArtifactID | urlquery}}&amp;seq={{.VersionSeq}}" hx-target="#pane-preview" hx-swap="innerHTML"
          onclick="showPane('preview')"><i class="ph ph-eye"></i> View v{{.VersionSeq}} in the preview first</button>
  <button type="button" class="btn" data-resume="{{.SessionID}}" data-rollback="{{.VersionSeq}}"><i class="ph ph-arrow-counter-clockwise"></i> Roll back to v{{.VersionSeq}} and continue</button>
  <p class="resume-explain">Puts the artifact’s code and saved data back as v{{.VersionSeq}} left them. It is recorded as a new version, so nothing is lost, and you can undo it from the Versions list.</p>
  <button type="button" class="btn btn-sec" data-resume="{{.SessionID}}" data-rollback="0">Continue without rolling back</button>
  <p class="resume-explain">Leaves the artifact as it is now. The agent is told it may have changed, and reads it again before changing anything.</p>
  <button type="button" class="resume-cancel"
          hx-get="/partials/agent-history?artifact={{.ArtifactID | urlquery}}" hx-target="#history" hx-swap="innerHTML">Cancel</button>
  <p class="resume-status" id="resume-status" role="status" aria-live="polite"></p>
</div>{{end}}{{end}}

{{/* conversationMeta is the one line under a conversation's title: the artifact
     version it was last working against (and whether that is still the one
     the artifact is at), and when it last ran. */}}
{{define "conversationMeta"}}{{if .VersionSeq}}Based on v{{.VersionSeq}}{{if .Current}} · current{{end}} · {{end}}<time datetime="{{.WhenISO}}">{{.When}}</time>{{end}}

{{/* One definition for history and the live-stream template. Live text exists
     only in the browser until the conversation is saved; agent.js clones this
     shell and writes deltas into the bubble, leaving actions untouched. Add
     buttons here and handlers in message-actions.js for future message tools. */}}
{{define "agentMessage"}}<div class="agent-message" data-agent-message>
  <div class="msg assistant" data-message-content>{{.}}</div>
  <div class="message-actions" role="group" aria-label="Message actions">
    <button type="button" class="message-action" data-message-action="copy" aria-label="Copy message text"><i class="ph ph-copy" aria-hidden="true"></i><span class="message-action-label" aria-hidden="true">Copy text</span></button>
    <span class="message-action-status" role="status" aria-live="polite" aria-atomic="true"></span>
  </div>
</div>{{end}}
