{{/* Shared gallery components. Data: galleryGridData. A gallery supplies its
     own ID and endpoint; these partials know nothing about its selection rule. */}}
{{define "gallerySearch"}}<form class="search-row" role="search" id="{{.ID}}-search" data-gallery-search data-gallery-preserve-query="true"
      action="{{.PagePath}}" method="get"
      hx-get="{{.FragmentPath}}" hx-trigger="submit, exhibit:gallery-search"
      hx-target="#{{.ID}}-results" hx-swap="innerHTML" hx-sync="#{{.ID}}:replace">
  {{if .Filters.Sections}}{{template "gallerySearchParameters" .}}{{end}}<i class="ph ph-magnifying-glass search-icon" aria-hidden="true"></i>
  <input type="text" name="q" data-gallery-query placeholder="Search" value="{{.Query}}" autocomplete="off" aria-label="Search artifacts" aria-keyshortcuts="/">
  <kbd class="search-kbd" aria-hidden="true">/</kbd>
  <button class="search-clear" type="button" data-gallery-clear aria-label="Clear search" hidden><i class="ph ph-x" aria-hidden="true"></i></button>
</form>{{end}}

{{define "galleryResults"}}<p class="gallery-error" data-gallery-search-error role="alert" hidden>Couldn’t load {{if .Activity}}activity{{else}}artifacts{{end}}. <button class="btn btn-sec" type="submit" form="{{.ID}}-search">Try again</button></p>
<p class="gallery-search-feedback" role="status">{{if .Activity}}Loading activity…{{else if .HideSearch}}Loading artifacts…{{else}}Searching your Gallery…{{end}}</p>
<p class="sr-only" id="{{.ID}}-status" role="status" aria-live="polite" aria-atomic="true">{{template "galleryResultStatus" .}}</p>
<div class="grid{{if .Activity}} activity-feed{{end}}" id="{{.ID}}-results" data-gallery-results>{{template "galleryGrid" .}}</div>{{end}}

{{/* Both the first page and every appended page execute this exact card loop.
     Replacing only the sentinel leaves existing widget frames running. */}}
{{define "galleryGrid"}}{{if .Activity}}{{template "activityItems" .}}{{else}}{{if eq .Offset 0}}{{template "galleryFilterChips" .}}{{end}}{{range .Cards}}{{template "galleryCard" .}}{{end}}
{{if .RetryURL}}{{template "galleryMore" .}}{{else}}
  {{if and (not .Cards) (eq .Offset 0)}}{{template "galleryEmpty" .EmptyState}}{{end}}
  {{if .NextURL}}{{template "galleryMore" .}}{{end}}
{{end}}{{end}}{{end}}

{{/* Data: galleryEmptyState. Every destination and miss shares the same text
     hierarchy and controls; only first-artifact Search uses the illustration. */}}
{{define "galleryEmpty"}}<section class="gallery-empty{{if .Welcome}} gallery-welcome{{end}}">
  {{if .Welcome}}{{template "galleryWelcomeArt"}}{{else if .Icon}}<i class="ph {{.Icon}}" aria-hidden="true"></i>{{end}}
  <h2 class="empty">{{.Message}}</h2>
  {{if .Hint}}<p class="empty-hint">{{.Hint}}</p>{{end}}
  {{if .ActionURL}}<a class="btn{{if not .Welcome}} btn-sec{{end}}" href="{{.ActionURL}}"{{if .ResetAction}} data-gallery-space-link hx-get="{{.ActionURL}}" hx-target="#gallery-content" hx-swap="outerHTML" hx-push-url="true" hx-sync="#gallery-shell:replace"{{end}}>{{if .Welcome}}<i class="ph ph-palette" aria-hidden="true"></i>{{end}}{{.ActionLabel}}</a>{{end}}
</section>{{end}}

{{define "galleryWelcomeArt"}}  <div class="welcome-art" aria-hidden="true">
    <div class="welcome-tool welcome-tool-list">
      <i class="ph ph-check-square"></i>
      <div class="welcome-checks"><i class="ph ph-check-circle"></i><span></span><i class="ph ph-check-circle"></i><span></span><i class="ph ph-circle"></i><span></span></div>
    </div>
    <div class="welcome-tool welcome-tool-timer">
      <i class="ph ph-timer"></i>
      <div class="welcome-progress"></div>
    </div>
    <div class="welcome-tool welcome-tool-chart">
      <i class="ph ph-chart-bar"></i>
      <div class="welcome-bars"><span></span><span></span><span></span><span></span><span></span></div>
    </div>
  </div>
{{end}}

{{define "galleryMore"}}<div class="gallery-more">
  <p class="gallery-error" data-gallery-load-error{{if not .RetryURL}} hidden{{end}}>Couldn’t load {{if .Activity}}activity{{else}}artifacts{{end}}. Try again.</p>
  <button class="btn btn-sec" type="button" data-gallery-page
          hx-get="{{if .RetryURL}}{{.RetryURL}}{{else}}{{.NextURL}}{{end}}"
          hx-trigger="{{if .RetryURL}}click{{else}}revealed, click{{end}}"
          hx-target="closest .gallery-more" hx-swap="outerHTML"
          hx-sync="#{{.ID}}:abort" hx-disabled-elt="this">{{if .RetryURL}}Try again{{else}}Load more{{end}}</button>
  <span class="gallery-loading" role="status">Loading {{if .Activity}}activity{{else}}artifacts{{end}}…</span>
</div>{{end}}

{{/* The tile, title, tag dots, posture/sharing glyphs and actions have one
     definition for every gallery. Delegated card clicks leave links and
     popover controls to their own handlers. */}}
{{define "galleryCard"}}<div class="card" data-href="/artifacts/{{.ArtifactID}}">
  {{template "cardWidget" .Widget}}
  <div class="card-meta"><a class="card-title" title="{{.Title}}" href="/artifacts/{{.ArtifactID}}">{{.Title}}</a>{{if .Starred}}<i class="ph ph-star card-star" role="img" aria-label="Starred"></i>{{end}}{{template "tagDots" .}}{{if not .ReadOnly}}{{template "capabilityCluster" .Capability}}{{end}}
    {{if .Actions.Items}}{{template "actionMenu" .Actions}}{{end}}
  </div>{{if .OwnerName}}<div class="card-by"><span class="card-owner-initial" aria-hidden="true">{{.OwnerInitial}}</span><span class="card-owner-name">{{.OwnerName}}</span></div>{{end}}
</div>{{end}}

{{define "gallerySearchParameters"}}<span id="{{.ID}}-search-parameters" hidden>{{range $name, $values := .Parameters}}{{range $values}}<input type="hidden" name="{{$name}}" value="{{.}}">{{end}}{{end}}</span>{{end}}

{{define "galleryFilterOptions"}}{{range .Filters.Sections}}<section class="gallery-filter-section"><h3>{{.Label}}</h3><ul>{{range .Options}}
<li><a href="{{.PageURL}}" hx-get="{{.FragmentURL}}" data-gallery-filter data-active="{{.Active}}" aria-label="{{if .Active}}Remove{{else}}Add{{end}} {{.Label}} filter">{{if .Color}}<span class="gallery-filter-dot" style="--tag-color:{{.Color}}" aria-hidden="true"></span>{{end}}<span>{{.Label}}</span>{{if .Active}}<i class="ph ph-check" aria-hidden="true"></i>{{end}}</a></li>
{{end}}</ul></section>{{end}}{{end}}

{{define "galleryFilterChips"}}{{if .Filters.Chips}}<div class="gallery-filter-chips" aria-label="Active filters" hx-target:inherited="#{{.ID}}-results" hx-swap:inherited="innerHTML" hx-sync:inherited="#{{.ID}}:replace" hx-include:inherited="#{{.ID}}-search [name=q]">
{{range .Filters.Chips}}<a href="{{.PageURL}}" hx-get="{{.FragmentURL}}" data-gallery-filter aria-label="Remove {{.Label}} filter">{{.Label}}<i class="ph ph-x" aria-hidden="true"></i></a>{{end}}
{{if gt (len .Filters.Chips) 1}}<a class="gallery-filter-clear" href="{{.Filters.ClearPageURL}}" hx-get="{{.Filters.ClearFragmentURL}}" data-gallery-filter>Clear all</a>{{end}}
</div>{{end}}{{end}}

{{define "galleryFilterSheet"}}<dialog id="{{.ID}}-filter-sheet" class="modal-dialog modal-sheet gallery-filter-sheet" data-filter-sheet-target="dialog" data-controller="modal" aria-labelledby="{{.ID}}-filter-title">
<div class="gallery-filter-heading modal-header"><h2 id="{{.ID}}-filter-title">Filters</h2><button class="btn btn-sec icon-btn" type="button" autofocus data-modal-dismiss aria-label="Close filters"><i class="ph ph-x" aria-hidden="true"></i></button></div>
<div class="modal-body" id="{{.ID}}-sheet-filters" hx-target:inherited="#{{.ID}}-results" hx-swap:inherited="innerHTML" hx-sync:inherited="#{{.ID}}:replace" hx-include:inherited="#{{.ID}}-search [name=q]">{{template "galleryFilterOptions" .}}</div>
<div class="modal-actions modal-footer"><button class="btn btn-sec gallery-filter-done" type="button" data-modal-dismiss>Done</button></div>
</dialog>{{end}}

{{/* Successful first-page htmx responses refresh external filter controls
     from the same partials. Paging never duplicates chips or changes controls. */}}
{{define "galleryResultStatus"}}{{if .Activity}}{{if .NextURL}}Recent changes loaded. More activity is available.{{else}}{{len .Activity.Items}} recent change{{if ne (len .Activity.Items) 1}}s{{end}} loaded.{{end}}{{else}}{{if .NextURL}}Artifacts loaded. More results are available.{{else}}{{len .Cards}} artifact{{if ne (len .Cards) 1}}s{{end}}{{if .Query}} matching “{{.Query}}”{{end}}.{{end}}{{end}}{{end}}

{{define "galleryFilterUpdate"}}{{template "galleryGrid" .}}
<p hx-swap-oob="innerHTML:#{{.ID}}-status">{{template "galleryResultStatus" .}}</p>
<div hx-swap-oob="innerHTML:#{{.ID}}-search-parameters">{{range $name, $values := .Parameters}}{{range $values}}<input type="hidden" name="{{$name}}" value="{{.}}">{{end}}{{end}}</div>
<div hx-swap-oob="innerHTML:#{{.ID}}-rail-filters">{{template "galleryFilterOptions" .}}</div>
<div hx-swap-oob="innerHTML:#{{.ID}}-sheet-filters">{{template "galleryFilterOptions" .}}</div>
{{end}}
