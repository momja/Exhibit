{{/*
  Shared partials for the gallery pages. Pill/button markup is kept on single
  lines: the gallery tests assert on contiguous markup substrings, and more to
  the point each pill is one inline element whose exact whitespace matters to
  flex layout less than to greppability.
*/}}

{{/* pwaHead is the PWA installability markup shared by every app-origin
     page head (av-fdcx): the manifest link plus the apple-* home-screen tags
     iOS Safari reads instead of manifest.json's display mode. It is static
     — no per-page data — so every template includes it the same way:
     {{template "pwaHead"}}. Never add this to the render surface's artifact
     document (internal/render) — artifacts are visitor-authored files and
     own their own <head> (architecture.md §1). */}}
{{define "pwaHead"}}<link rel="manifest" href="/manifest.json">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon-180.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Exhibit">{{end}}

{{/* tagDots renders a gallery card's tags as color alone (av-uvc6): one dot
     per tag, in the card's single meta row beside the title. The name is not
     drawn but is not lost either: it is the dot's title for a pointer and
     sr-only text for a screen reader, which reads the list as a list of tag
     names. Each li is a little wider than the dot it draws so the tooltip has
     something to land on. Tags are edited on the edit page (tagPanelBody).
     Data: {Tags []tagView}. */}}
{{define "tagDots"}}{{if .Tags}}<ul class="tag-dots" aria-label="Tags">{{range .Tags}}<li class="tag-dot-item" data-tag-id="{{.ID}}" style="--tag-color:{{.Color}}" title="{{.Name}}"><span class="sr-only">{{.Name}}</span></li>{{end}}</ul>{{end}}{{end}}

{{/* colorSwatches renders the shared preset-color palette used by both the
     edit-tag modal and the Tags panel's create-new fields. Swatches are
     plain buttons scoped by the caller's modal id in CSS/JS, so the markup
     itself carries no modal-specific state. The swatch/dot backgrounds stay
     inline styles: they are per-tag dynamic values, which classes cannot
     express. Data: []string (hex colors). */}}
{{define "colorSwatches"}}<div class="color-presets">{{range .}}<button type="button" class="color-swatch" data-color="{{.}}" style="background:{{.}}" aria-label="{{.}}"></button>{{end}}</div>{{end}}

{{/* editTagModal renames, recolors or deletes a tag library-wide; opened
     from the Tags panel's pencils by tags.js. Data: []string (presets). */}}
{{define "editTagModal"}}<div id="tag-edit-modal" class="modal-overlay" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="tag-edit-title">
    <h2 id="tag-edit-title">Edit tag</h2>
    <label for="tag-edit-name">Name</label>
    <input type="text" id="tag-edit-name" maxlength="60">
    <label>Color</label>
    {{template "colorSwatches" .}}
    <div class="color-custom-row">
      <input type="color" id="tag-edit-color-picker" aria-label="Custom color">
      <input type="text" id="tag-edit-color-hex" placeholder="#rrggbb" maxlength="7" aria-label="Color hex code">
    </div>
    <div id="tag-edit-error" class="modal-error" hidden></div>
    <div class="modal-actions">
      <button type="button" class="btn btn-danger" id="tag-edit-delete"><i class="ph ph-trash"></i> Delete</button>
      <span class="spacer"></span>
      <button type="button" class="btn btn-sec" id="tag-edit-cancel">Cancel</button>
      <button type="button" class="btn" id="tag-edit-save"><i class="ph ph-check"></i> Save</button>
    </div>
  </div>
</div>{{end}}

{{/* fragmentError is the user-facing 404 body every /partials/* route serves
     when its artifact is gone (av-3cdp): htmx 4 swaps 4xx responses, so the
     pane shows this notice instead of keeping a stale view with no
     explanation. Kept on one line like the pill markup above — the fragment
     tests assert on the contiguous class attr. Data: string (the message). */}}
{{define "fragmentError"}}<div class="frag-error"><i class="ph ph-warning-circle"></i><span>{{.}}</span></div>{{end}}

{{/* versionViewer is an earlier version of an artifact, shown running in a frame
     beneath a bar that says what it is — to be looked at before deciding
     whether to return to it, and never to keep. It is swapped into the chat's
     preview pane from the History card and into the edit page's Versions
     panel, so the two show one thing the same way. Rendered by
     GET /partials/version-viewer (versionviewer.go). Data: versionViewerData.

     Three properties are the point, and each is held somewhere other than here:
     - The frame is the render surface's version document: the code as it was,
       with the data that version left behind, under a token for that version
       alone. Nothing done in it is saved — its shim does not write through and
       its response is sandboxed by its own CSP (render.ServeVersion).
     - It carries no id="pv-frame". The chat page's bridges (state, snippet
       picker, network prompt) listen to that element and nothing else, so a
       version frame is not the page's artifact frame and a message it sends,
       forged or not, is not heard. Do not give it that id.
     - The bar says it is a preview and that nothing is saved, so what is
       shown is never mistaken for the artifact as it is.

     And it says so again, louder, the moment the tool actually tries to save.
     A tool that saves quietly looks exactly like one that has, so the first
     write the view refuses is reported by the frame (__avVersionUnsaved: no
     key, no value) and components.js reveals the banner below — in the page's
     own chrome, in the same style as the capability warning, and never in the
     artifact's DOM, which the artifact could forge. That message is the one
     thing the page listens to this frame for, and the listener's whole effect is
     showing this sentence, so a notice the artifact forges is no worse than the
     notice appearing. It stays up until the viewer is replaced, because a
     warning that fades is one the person may not have read.

     The close button carries only data-action="close-version-viewer": what
     closing means is the page's (the chat re-renders its preview pane; the
     edit page empties the slot), so each page's script owns it. Restorable is
     the edit page asking for the restore beside the view, where it is decided;
     it also decides what the notice tells a person to press, since each page
     names the way back to a version differently (the edit page's Restore, the
     chat card's Roll back). */}}
{{define "versionViewer"}}<div class="version-viewer" id="version-viewer">
  <div class="version-viewer-bar" role="status">
    <i class="ph ph-eye" aria-hidden="true"></i>
    <div class="version-viewer-text">
      <div class="version-viewer-what">Viewing <strong>v{{.Seq}}</strong> <span class="version-viewer-meta">· {{.Label}}{{if .Message}} — {{.Message}}{{end}} · <time datetime="{{.WhenISO}}">{{.When}}</time></span></div>
      <div class="version-viewer-note">A preview — nothing you do here is saved.</div>
    </div>
    <div class="version-viewer-actions">
      {{if .Restorable}}<button type="button" class="btn btn-sm" data-action="restore" data-seq="{{.Seq}}"><i class="ph ph-arrow-counter-clockwise"></i> Restore v{{.Seq}}</button>{{end}}
      <button type="button" class="btn btn-sm btn-sec" data-action="close-version-viewer">Back to current</button>
    </div>
  </div>
  <div class="banner banner-warn" id="version-viewer-unsaved" role="alert" hidden>
    <i class="ph ph-warning" aria-hidden="true"></i>
    <div class="banner-body">
      <span>Changes aren't saved while you preview v{{.Seq}}. {{if .Restorable}}Restore{{else}}Roll back to{{end}} v{{.Seq}} to make it the active version.</span>
      <details class="banner-details">
        <summary>Details</summary>
        <p>This is v{{.Seq}} as it was, running with the data it left behind. Nothing you change in it is sent to the server, and it is discarded when you leave the preview. Once v{{.Seq}} is the active version, changes you make are saved as usual.</p>
      </details>
    </div>
  </div>
  <div class="version-viewer-body"><iframe class="version-viewer-frame" src="{{.FrameURL}}" sandbox="allow-scripts allow-forms" title="{{.Title}}, version {{.Seq}}"></iframe></div>
</div>{{end}}

{{/* tagPanelBody is the edit page's Tags panel body: current tags with
     edit/remove controls, plus an add-or-create row. Shared by the page render
     and /partials/tag-panel. Data: tagPanelView (gallery.go). */}}
{{define "tagPanelBody"}}<div class="tag-panel" data-artifact-id="{{.ArtifactID}}">
  {{if .Tags}}<ul class="tag-edit-list" id="tag-edit-list">
    {{range .Tags}}<li class="tag-pill tag-pill-editable" data-tag-id="{{.ID}}">
      <span class="tag-dot" style="background:{{.Color}}" aria-hidden="true"></span>
      <span class="tag-pill-label">{{.Name}}</span>
      <button type="button" class="tag-pill-btn" data-action="edit-tag" data-tag-id="{{.ID}}" data-tag-name="{{.Name}}" data-tag-color="{{.Color}}" aria-label="Edit tag {{.Name}}" title="Rename, recolor or delete this tag"><i class="ph ph-pencil-simple" aria-hidden="true"></i></button>
      <button type="button" class="tag-pill-btn" data-action="detach-tag" data-tag-id="{{.ID}}" aria-label="Remove tag {{.Name}} from this artifact" title="Remove from this artifact"><i class="ph ph-x" aria-hidden="true"></i></button>
    </li>{{end}}
  </ul>{{else}}<p class="text-sm muted">This artifact has no tags.</p>{{end}}
  <div class="tag-add-row">
    <select id="tag-add-select" class="select" aria-label="Tag to add">
      <option value="">Add a tag…</option>
      {{range .Available}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
      <option value="__new__">+ Create new tag</option>
    </select>
    <button type="button" class="btn btn-sm" id="tag-add-confirm"><i class="ph ph-plus"></i> Add</button>
  </div>
  <div id="tag-add-create-fields" class="tag-create" hidden>
    <label for="tag-add-name" class="text-sm muted">Name</label>
    <input type="text" id="tag-add-name" class="field" maxlength="60">
    <span class="text-sm muted">Color</span>
    {{template "colorSwatches" .Presets}}
    <div class="color-custom-row">
      <input type="color" id="tag-add-color-picker" value="{{.DefaultColor}}" aria-label="Custom color">
      <input type="text" id="tag-add-color-hex" class="field" value="{{.DefaultColor}}" placeholder="#rrggbb" maxlength="7" aria-label="Color hex code">
    </div>
  </div>
</div>{{end}}

{{/* capabilityCluster renders the gallery card's / viewer toolbar's neutral
     sandbox-posture glyph cluster (av-isb3) as a focusable trigger for its
     detail popover (av-41se), plus the popover itself. The allowlist is
     transparency, not a verdict (spec 6.2) — no green/amber, ever. Fully
     sandboxed (empty allowlist, neither capability approved) collapses to a
     single muted ph-shield-check + "Sandboxed"; otherwise each grant gets its
     own neutral glyph, in a fixed order: network count, then downloads,
     clipboard, external links, camera, microphone.

     The gallery card renders the Compact form (av-uvc6): no "Sandboxed"
     label, the sharing glyph after the capability glyphs, and nothing at all
     when neither has anything to say (capabilityView.HasTrigger). Glyphs
     alone carry no accessible name, so the compact trigger names itself.

     The trigger is tabindex=0 + role=button so it's reachable by
     keyboard independent of the card/toolbar around it; aria-describedby
     wires it to the popover div by id. The popover opens only on explicit
     activation (click/tap, or Enter/Space while focused) via components.js;
     hover/focus alone just apply a CSS affordance highlight
     (.capability-cluster:hover/:focus-visible) without opening anything.
     Data: capabilityView (gallery.go). */}}
{{define "capabilityCluster"}}{{if .HasTrigger}}<div class="capability-wrap"><div class="capability-cluster{{if not .Sandboxed}} has-grants{{end}}" tabindex="0" role="button" aria-haspopup="true" aria-expanded="false" aria-describedby="capability-popover-{{.ArtifactID}}" data-capability-trigger{{if .Compact}} aria-label="{{if .Share.Level}}Sandbox posture and sharing{{else}}Sandbox posture{{end}}"{{end}}>{{if .Sandboxed}}{{if not .Compact}}<span class="capability-glyph"><i class="ph ph-shield-check"></i></span> Sandboxed{{end}}{{else}}{{if .NetworkAllowlist}}<span class="capability-glyph"><i class="ph ph-globe"></i></span><span class="capability-count">{{len .NetworkAllowlist}}</span>{{end}}{{if .DownloadsApproved}}<span class="capability-glyph"><i class="ph ph-download-simple"></i></span>{{end}}{{if .ClipboardApproved}}<span class="capability-glyph"><i class="ph ph-clipboard"></i></span>{{end}}{{if .LinksApproved}}<span class="capability-glyph"><i class="ph ph-arrow-square-out"></i></span>{{end}}{{if .CameraApproved}}<span class="capability-glyph"><i class="ph ph-camera"></i></span>{{end}}{{if .MicrophoneApproved}}<span class="capability-glyph"><i class="ph ph-microphone"></i></span>{{end}}{{if .GeolocationApproved}}<span class="capability-glyph"><i class="ph ph-map-pin"></i></span>{{end}}{{end}}{{if .Share.Level}}<span class="capability-glyph capability-share capability-share-{{.Share.Level}}"><i class="ph {{.Share.Icon}}"></i></span>{{end}}</div>{{template "capabilityPopover" .}}</div>{{end}}{{end}}

{{/* panelCaret is the open/closed caret pair every .details-panel summary
     leads with (the edit page's security, artifact source, and gallery widget
     sections). Two glyphs swapped by [open] in components.css rather than one
     rotated in place — see the comment there for why. Takes no data. */}}
{{define "panelCaret"}}<i class="ph ph-caret-right details-caret details-caret-closed" aria-hidden="true"></i><i class="ph ph-caret-down details-caret details-caret-open" aria-hidden="true"></i>{{end}}

{{/* cardWidget is an artifact's tile (av-fafu) — the top band of its gallery
     card, and the same markup the edit page's widget preview renders so the
     author sees the tile exactly as the library will.

     The default monogram tile is ALWAYS in the markup, and the widget frame
     (when there is one) sits over it. That is not redundancy — it is what
     makes the failure path free: a widget that 404s, throws, or draws nothing
     is hidden by one class from components.js and the monogram is simply
     already there, with no markup for page JS to build and no second
     definition of the tile. For an artifact with no widget the monogram IS the
     tile and no frame loads at all.

     `has-frame` is what keeps the monogram a fallback rather than a backdrop:
     widgets render on a transparent background by contract, so a monogram left
     painted underneath a working widget shows straight through it. The class
     hides the default layer while a frame is live and the stylesheet brings it
     back on failure — done with an explicit class rather than :has() so the
     rule is greppable from the markup.

     The frame is inert on purpose: pointer-events are off in CSS so a click
     passes through to the card (which opens the artifact), and tabindex=-1
     keeps its contents out of the tab order — the widget states a fact, it is
     not a control. The <title> is the accessible name every iframe needs.
     Data: widgetView (gallery.go). */}}
{{define "cardWidget"}}<div class="card-widget{{if .URL}} has-frame{{end}}"><div class="card-widget-default" style="--tile-hue:{{.Hue}}"><span class="card-widget-monogram">{{.Monogram}}</span></div>{{if .URL}}<iframe class="card-widget-frame" src="{{.URL}}" sandbox="allow-scripts" loading="lazy" tabindex="-1" scrolling="no" title="{{.Title}} widget"></iframe>{{end}}</div>{{end}}

{{/* capabilityPopover is the "receipt" for what was approved at ingest
     (spec 6.2) — capabilityCluster's aria-describedby target. One row per
     active grant (network origins in monospace, then downloads, clipboard,
     external links, camera, microphone); the no-grants state collapses to a single "Fully contained"
     reassurance row instead. A shared artifact on a gallery card adds a
     Sharing section (av-uvc6) naming the strongest share level and the full
     sentence of everything true, which the card's badge used to carry as
     visible text and a title. The footer "Manage" link is omitted whenever
     ShowManage is false (the no-owner-session / share case). Data:
     capabilityView (gallery.go). */}}
{{define "capabilityPopover"}}<div class="capability-popover" id="capability-popover-{{.ArtifactID}}"><div class="capability-popover-header">Sandbox posture</div>{{if .Sandboxed}}<div class="capability-popover-row"><span class="capability-glyph"><i class="ph ph-shield-check"></i></span><span>Fully contained — no network, download, clipboard, external link, camera, microphone, or location access</span></div>{{else}}{{if .NetworkAllowlist}}<div class="capability-popover-row"><span class="capability-glyph"><i class="ph ph-globe"></i></span><div><div class="capability-popover-label">Network — {{len .NetworkAllowlist}} origin{{if ne (len .NetworkAllowlist) 1}}s{{end}}</div><div class="capability-popover-origins">{{range .NetworkAllowlist}}<code>{{.}}</code>{{end}}</div></div></div>{{end}}{{if .DownloadsApproved}}<div class="capability-popover-row"><span class="capability-glyph"><i class="ph ph-download-simple"></i></span><span>Downloads — Can save files to your device</span></div>{{end}}{{if .ClipboardApproved}}<div class="capability-popover-row"><span class="capability-glyph"><i class="ph ph-clipboard"></i></span><span>Clipboard — Can read and write your clipboard</span></div>{{end}}{{if .LinksApproved}}<div class="capability-popover-row"><span class="capability-glyph"><i class="ph ph-arrow-square-out"></i></span><span>External links — Can open links in new tabs</span></div>{{end}}{{if .CameraApproved}}<div class="capability-popover-row"><span class="capability-glyph"><i class="ph ph-camera"></i></span><span>Camera — Can capture video from your camera</span></div>{{end}}{{if .MicrophoneApproved}}<div class="capability-popover-row"><span class="capability-glyph"><i class="ph ph-microphone"></i></span><span>Microphone — Can capture audio from your microphone</span></div>{{end}}{{if .GeolocationApproved}}<div class="capability-popover-row"><span class="capability-glyph"><i class="ph ph-map-pin"></i></span><span>Location — Can read your location</span></div>{{end}}{{end}}{{if .Share.Level}}<div class="capability-popover-section"><div class="capability-popover-header">Sharing</div><div class="capability-popover-row"><span class="capability-glyph"><i class="ph {{.Share.Icon}}"></i></span><div><div class="capability-popover-label">{{.Share.Label}}</div><div>{{.Share.Detail}}</div></div></div></div>{{end}}{{if .ShowManage}}<a class="capability-popover-manage" href="/artifacts/{{.ArtifactID}}/edit#security-panel">Manage security settings →</a>{{end}}</div>{{end}}

{{/* sharePanel is the owner's sharing surface on the artifact detail page
     (av-6xjd). Rendered only when detailPageData.Share is non-nil, which is
     only for the owner — a recipient may use the artifact, and who else was
     given it is not part of what a grant carries.

     The body is split in two on purpose. #share-body is what htmx swaps after
     every change, so it holds the server's truth and nothing else; the results
     and status lines sit OUTSIDE it, in the stable part, because a bulk grant's
     per-name report ("tpyo — no such account") is exactly what the swap that
     follows the grant would otherwise wipe before it could be read.

     A swap, not a reload: this page holds a live artifact frame, and reloading
     to show a new guest list would restart the tool the owner is looking at.
     Data: detailPageData (gallery.go). */}}
{{/* The owner's share panel (av-esa1). A modal, not a panel that holds
     layout: sharing is an occasional action on a page whose subject is the
     running tool, so it takes no room until it is asked for.

     It reuses the modal-overlay/modal markup the four capability dialogs on
     this page already use, rather than a <dialog>. Those styles and their
     backdrop-and-Escape close behaviour exist; a second modal idiom on one
     page would cost more than the newer element buys.

     #share-panel is the stable id share.js delegates every listener from —
     htmx replaces the contents of #share-body underneath it, so a listener
     bound inside that region would be bound to a node that no longer exists
     after the first change. */}}
{{define "sharePanel"}}<div id="share-panel" class="modal-overlay" hidden>
  <div class="modal share-modal" role="dialog" aria-modal="true" aria-labelledby="share-title">
    <h2 id="share-title"><i class="ph ph-share-network"></i> Share settings</h2>
    <div id="share-body"
         hx-get="/partials/share-panel?artifact={{.ID}}"
         hx-trigger="exhibit:shares-changed from:body"
         hx-swap="innerHTML">{{template "sharePanelBody" .Share}}</div>
    {{/* Written by share.js, one row per submitted name. Outside the swap. */}}
    <div id="share-add-results" class="share-results"></div>
    <div class="modal-actions">
      <span id="share-status" class="text-sm muted"></span>
      <span class="spacer"></span>
      <button type="button" class="btn btn-sec" id="share-close">Done</button>
    </div>
  </div>
</div>{{end}}

{{/* sharePanelBody is the swappable half: three independent controls and the
     list of who currently holds access. It is the same partial for the initial
     page render and for /partials/share-panel, which is what keeps one
     definition of the guest list — the alternative is page JS rebuilding these
     rows in a second language, over recipient names it would then have to
     escape by hand. html/template's contextual escaping is that defence here,
     and a name is attacker-influenced text (a login name, or an address an
     identity provider reported).

     Data: sharePanelView (gallery.go). */}}
{{define "sharePanelBody"}}<div class="share-cols" data-artifact-id="{{.ArtifactID}}">
  <section class="share-col">
    <h3 class="text-sm muted">People</h3>
    {{/* One field taking several names and one submit: "gave friends access,
         dropped the link in the group chat" is one gesture, not three. The
         field confirms existence deliberately — answering "added" for a name
         nobody holds would leave the owner believing their friend has access
         when the friend has none, which is discovered weeks later and by the
         wrong person. */}}
    <div class="share-add">
      <input type="text" id="share-add-input" class="field" placeholder="Usernames or emails, separated by commas" autocomplete="off" aria-label="Usernames or emails, separated by commas">
      <button type="button" class="btn btn-sm" id="share-add-btn"><i class="ph ph-user-plus"></i> Give access</button>
    </div>
    {{if .Shares.Grants}}
    <ul class="share-grants" id="share-grants">
      {{range .Shares.Grants}}<li class="share-grant" data-share-id="{{.ID}}">
        <span class="share-grant-name">{{.Name}}</span>
        {{/* A disabled account is shown rather than filtered: a row that
             silently vanishes is a row the owner cannot revoke and does not
             know exists. */}}
        {{if .Disabled}}<span class="text-sm muted">account disabled</span>{{end}}
        <span class="spacer"></span>
        <button type="button" class="btn btn-sm btn-sec" data-action="revoke" data-share-id="{{.ID}}" aria-label="Revoke access for {{.Name}}"><i class="ph ph-x"></i> Revoke</button>
      </li>{{end}}
    </ul>
    {{else}}<p class="text-sm muted">Nobody else has been given access.</p>{{end}}
  </section>

  <section class="share-col">
    <h3 class="text-sm muted">Public link</h3>
    {{/* A toggle, not a create button, because an artifact has exactly one
         anonymous link (a partial unique index, av-lrae): on mints the row and
         shows the URL, off deletes it and the URL dies. Nothing accumulates a
         list of links whose destinations nobody remembers, and revoking has
         exactly one meaning. */}}
    {{/* The row's share id rides on the toggle itself: switching the link off
         is a DELETE of that row, and the id is the only thing the page needs
         to know about it. */}}
    <label class="row">
      <input type="checkbox" id="share-link-toggle"{{if .Shares.Link}} checked data-share-id="{{.Shares.Link.ID}}"{{end}}>
      <span class="spacer">Anyone with the link can open this artifact</span>
    </label>
    {{if .Shares.Link}}
    <div class="share-link-row">
      <input type="text" id="share-link-url" class="field" readonly value="{{.Shares.Link.URL}}" aria-label="Public link">
      <button type="button" class="btn btn-sm btn-sec" id="share-link-copy"><i class="ph ph-copy"></i> Copy</button>
    </div>
    {{/* Rotation earns its own control: a leaked link wants replacing, and
         toggling off then on gets there while leaving the user unsure it
         worked. One step, and it says outright what it costs. */}}
    <div class="btn-row">
      <button type="button" class="btn btn-sm btn-sec" id="share-link-replace"><i class="ph ph-arrows-clockwise"></i> Replace link</button>
      <span class="text-sm muted">The current link stops working.</span>
    </div>
    {{/* The shared tile (av-ei5h): an iframe snippet for the link's widget,
         or its default tile when it has none (av-cp7j). The URL inside is
         live exactly while this link is — replacing the link replaces it. */}}
    {{if .WidgetEmbed}}
    <div class="share-link-row">
      <input type="text" id="share-widget-embed" class="field" readonly value="{{.WidgetEmbed}}" aria-label="Shared widget embed code">
      <button type="button" class="btn btn-sm btn-sec" id="share-widget-copy"><i class="ph ph-copy"></i> Copy</button>
    </div>
    <p class="text-sm muted">Embeddable tile showing this tool's saved data. Read-only, like the public link.</p>
    {{end}}
    {{end}}

    <h3 class="text-sm muted">Saved data</h3>
    {{/* One answer per artifact, not per person: "shared board or private
         copies" is one question, and per-grant would admit one recipient on
         their own rows while another writes the owner's — a state nobody wants
         and one that makes "whose data am I looking at" unexplainable. */}}
    <select id="share-state-mode" class="select" aria-label="Saved data">
      <option value="own"{{if not .StateModeShared}} selected{{end}}>Each person keeps their own data</option>
      <option value="shared"{{if .StateModeShared}} selected{{end}}>Everyone shares one copy</option>
    </select>
    <p class="text-sm muted">With one shared copy, anything the people above type is visible to you and to each other, and they can change what you saved.</p>
  </section>
</div>{{end}}

{{/* settingsHeader is the sub-page header the account surfaces share: a back
     link to the gallery and the page's own title, the same idiom new.tmpl and
     detail.tmpl use. Data: the page title (a string).

     It exists as a partial rather than inline markup because two pages will
     wear it and they must not merge: this ticket's /admin/users (an admin
     acting on the instance) and av-qwld's own-account settings page (a person
     acting on themselves). Sharing the furniture is the point; sharing the
     authority would be the bug — that lives on the route, in adminOnly. */}}
{{define "settingsHeader"}}<header>
  <a href="/">←<span class="back-label"> Gallery</span></a>
  <h1>{{.}}</h1>
</header>{{end}}

{{/* The runtime network-permission dialog (av-kmwj), shared by every page that
     embeds an artifact: the detail viewer and the agent chat's preview pane
     (av-6xvs). One definition because the two pages must offer the same three
     answers with the same ids — web/gallery/network-prompt.js drives it and
     addresses those ids by name.

     It lives in app chrome and never inside the artifact's frame: the artifact
     owns that DOM and could draw a convincing forgery of this dialog. The
     origin and directive are filled in by script via textContent, because they
     come out of the artifact's own blocked request and must never be
     interpolated as markup here. */}}
{{define "networkPrompt"}}<div id="net-modal" class="modal-overlay" hidden>
  <div class="modal modal-wide" role="dialog" aria-modal="true" aria-labelledby="net-title">
    <h2 id="net-title">Allow network access?</h2>
    <p>This artifact tried to contact <code id="net-origin"></code> and was blocked.</p>
    <p class="text-sm muted" id="net-directive"></p>
    <p>Allowing adds this origin to the artifact's allowlist and reloads the artifact so the request can retry. You can revoke it later in allowlist settings.</p>
    <div class="modal-actions">
      <button type="button" class="btn btn-sec" id="net-never">Don't ask again</button>
      <span class="spacer"></span>
      <button type="button" class="btn btn-sec" id="net-once">Block once</button>
      <button type="button" class="btn" id="net-allow"><i class="ph ph-globe-hemisphere-west"></i> Allow origin</button>
    </div>
  </div>
</div>{{end}}
