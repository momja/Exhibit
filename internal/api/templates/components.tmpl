{{/* Include once on an app page using shared controllers. The native module
     imports only app-origin assets, starts one application, and registers
     controllers explicitly. htmx fragments contain markup only. */}}
{{define "componentScripts"}}<script type="module" src="{{asset "gallery/controllers.js"}}"></script>{{end}}

{{/* Data: actionMenuView. A link navigates normally; an event item dispatches
     its named, bubbling feature event with its payload and the visible trigger
     in event.detail. Feature code owns API calls and refresh events. */}}
{{define "actionMenu"}}<div class="action-menu-container{{if .Class}} {{.Class}}{{end}}" data-controller="action-menu"
  data-action="click@window->action-menu#dismiss focusout->action-menu#focusOut keydown->action-menu#navigate action-menu:opened@window->action-menu#closeOther">
  <button type="button" class="btn btn-sec icon-btn{{if .TriggerClass}} {{.TriggerClass}}{{end}}" id="{{.ID}}-trigger"
    data-action-menu-target="trigger" data-action="action-menu#toggle"
    aria-label="{{.Label}}" title="Actions" aria-haspopup="menu" aria-expanded="false" aria-controls="{{.ID}}"><i class="ph ph-dots-three-vertical" aria-hidden="true"></i></button>
  <div class="action-menu action-menu-panel{{if .PanelClass}} {{.PanelClass}}{{end}}" id="{{.ID}}" role="menu" aria-labelledby="{{.ID}}-trigger" data-action-menu-target="menu" hidden>
    {{range .Items}}{{if .Href}}<a href="{{.Href}}" role="menuitem" tabindex="-1" data-action-menu-target="item" data-action="action-menu#select">{{if .Icon}}<i class="ph {{.Icon}}" aria-hidden="true"></i> {{end}}{{.Label}}</a>
    {{else}}<button type="button" role="menuitem" tabindex="-1" data-action-menu-target="item" data-action="action-menu#select" data-action-menu-event-param="{{.Event}}" data-action-menu-payload-param="{{.Payload}}">{{if .Icon}}<i class="ph {{.Icon}}" aria-hidden="true"></i> {{end}}{{.Label}}</button>{{end}}{{end}}
  </div>
</div>{{end}}

{{/* Data: appHeaderView. Page code supplies navigation and actions; this
     component owns the frame and responsive labels. Gallery search remains
     a server-rendered partial, including its filter-sheet controller hooks.
     Standard links/buttons stay native. The floating variant connects the
     shared floating-header controller for dragging, placement and popups. */}}
{{define "appHeader"}}{{if .Floating}}{{template "floatingAppHeader" .Floating}}{{else}}<header class="app-header" data-app-header>
  {{if .Logo}}{{.Logo}}{{end}}
  {{with .Back}}<a class="app-header-back{{if .CollapseLabel}} app-header-back-collapse{{end}}" href="{{.URL}}" title="{{.Label}}"><i class="ph ph-arrow-left" aria-hidden="true"></i> <span class="app-header-back-label">{{.Label}}</span></a>{{end}}
  {{if .Title}}<h1 class="app-header-title{{if .HideTitle}} sr-only{{end}}">{{if .TitleIcon}}<i class="ph {{.TitleIcon}}" aria-hidden="true"></i> {{end}}{{.Title}}</h1>{{end}}
  {{with .Search}}{{template "galleryHeaderSearch" .}}{{end}}
  <span class="spacer"></span>
  {{if .Actions}}<div class="app-header-actions">
    {{range .Actions}}{{template "appHeaderAction" .}}{{end}}
  </div>{{end}}
  {{if .Account}}{{template "accountControl" .Clerk}}{{end}}
</header>{{end}}{{end}}

{{define "appHeaderAction"}}{{if .Href}}<a class="btn{{if not .Primary}} btn-sec{{end}}{{if .IconOnly}} icon-btn{{end}}" href="{{.Href}}" aria-label="{{.Label}}" title="{{.Label}}">{{template "appHeaderActionContent" .}}</a>
{{else}}<button type="button" class="btn{{if not .Primary}} btn-sec{{end}}{{if .IconOnly}} icon-btn{{end}}"{{if .ID}} id="{{.ID}}"{{end}}{{if .SaveEditor}} data-save-editor{{end}} aria-label="{{.Label}}" title="{{.Label}}">{{template "appHeaderActionContent" .}}</button>{{end}}{{end}}

{{define "appHeaderActionContent"}}{{if .Icon}}<i class="ph {{.Icon}}" aria-hidden="true"></i>{{end}}{{if not .IconOnly}}<span class="header-link-label"{{if .LabelID}} id="{{.LabelID}}"{{end}}>{{.Label}}</span>{{end}}{{end}}

{{/* Data: floatingHeaderView. This is the viewer's shared header variant;
     its popups and restore tab stay outside the transformed pill. */}}
{{define "floatingAppHeader"}}<header class="app-header-floating" data-app-header data-controller="floating-header">
<div class="pip" id="pip" role="toolbar" aria-label="Artifact controls">
  <a class="pip-btn" href="/" aria-label="My library" title="My library"><i class="ph ph-squares-four" aria-hidden="true"></i></a>
  <span class="pip-sep"></span>
  <button type="button" class="pip-grip" id="pip-grip" title="Drag to move" aria-label="Move controls. Drag them, or use the arrow keys. Past the left or right edge puts them away."></button>
  {{/* The posture button opens the info card and summarizes the cluster (Exh-ghuv). The mark is an htmx
       target (av-mf1x): after a runtime origin approval the prompt fires
       exhibit:capabilities-changed on <body>, and the mark and the receipt in
       the card each take their half of the same fragment. For a recipient
       htmx is not loaded and these attributes are inert, since they cannot
       approve anything and so there is nothing to refresh. */}}
  <button type="button" class="pip-title" id="pip-title" title="About this artifact" aria-labelledby="pip-info-title pip-posture" aria-expanded="false" aria-controls="pip-info">
    <span id="pip-posture"
          hx-get="/partials/capability-cluster?artifact={{.ID}}"
          hx-trigger="exhibit:capabilities-changed from:body"
          hx-select=".pip-posture"
          hx-swap="innerHTML">{{template "postureGlyph" .Capability}}</span>
    <i class="ph ph-caret-down pip-caret" aria-hidden="true"></i>
  </button>
  <span class="pip-sep"></span>
  {{/* Opens the share modal (av-esa1). .Share gates it on the same value that
       decides whether the modal is rendered at all, so the control and its
       target cannot disagree about who is an owner. */}}
  {{if .CanShare}}<button type="button" class="pip-btn" id="share-open" aria-label="Share" title="Share"><i class="ph ph-share-network" aria-hidden="true"></i></button>{{end}}
  <button type="button" class="pip-btn" id="pip-more" aria-label="More actions" title="More" aria-expanded="false" aria-controls="pip-menu"><i class="ph ph-dots-three-vertical" aria-hidden="true"></i></button>
</div>
{{/* The info card: facts about the artifact, opened from the posture button. The
     receipt stays for everyone, and the link to change it does not. What this
     artifact may reach is a fact about the tool running in the visitor's own
     browser, the one piece of the owner's configuration a recipient has a
     direct stake in, and what the CSP-block explanation points back at. The
     receipt's Manage link follows ShowManage, which is the same ReadOnly
     narrowing as everything else on this page.

     Outside the pill rather than inside it: the pill is transformed and
     blurred, and either makes it the containing block of a fixed-position
     child, which would pin the card to the pill instead of the window. */}}
<div class="pip-popup pip-info" id="pip-info" role="region" aria-label="About this artifact" tabindex="-1" hidden>
  <h1 class="pip-info-title" id="pip-info-title">{{.Title}}</h1>
  <div class="pip-info-meta">Created {{.Created}}</div>
  <div id="capability-cluster"
       hx-get="/partials/capability-cluster?artifact={{.ID}}"
       hx-trigger="exhibit:capabilities-changed from:body"
       hx-select=".capability-popover, .frag-error"
       hx-swap="innerHTML">{{template "capabilityPopover" .Capability}}</div>
</div>
<div class="pip-popup pip-menu action-menu" id="pip-menu" hidden>
  <button type="button" id="direct-open-toolbar"><i class="ph ph-arrow-square-out" aria-hidden="true"></i> Open in new tab</button>
  {{/* Everything from here to the divider belongs to the artifact's OWNER
       (av-awr4). A recipient reached this page through a grant, which is read
       access to the artifact and nothing else, so each of these would answer
       404 from a server that has always been owner-scoped: /edit and /agent
       read the body, the export reads it too, and refetch rewrites it.
       Rendering them and letting them fail is the specific dishonesty this
       gate exists to remove — a control that does nothing teaches the visitor
       the tool is flaky rather than that it is not theirs.

       The condition is .ReadOnly, from pageCredentials, and deliberately not a
       second flag of this template's own: it is the same value api.js refuses
       writes on, so what the page offers and what the page may send cannot
       drift apart. */}}
  {{if not .ReadOnly}}
  <a href="/artifacts/{{.ID}}/edit"><i class="ph ph-pencil-simple" aria-hidden="true"></i> Edit</a>
  <a href="/agent?artifact={{.ID}}"><i class="ph ph-robot" aria-hidden="true"></i> Modify with agent</a>
  {{if .CanConnectAgents}}<button type="button" id="agent-grants-open"><i class="ph ph-plugs-connected" aria-hidden="true"></i> Connect your own agent</button>{{end}}
  {{/* The portable copy (av-vnkt): one file with every stored payload folded
       back in, depending on no origin and no running instance. A plain link,
       because the response is an attachment — no JS, and it works from the
       page a visitor is already on. */}}
  <a href="/api/artifacts/{{.ID}}/export" download><i class="ph ph-download-simple" aria-hidden="true"></i> Download file</a>
  {{if .SourceURL}}<button type="button" onclick="refetchSource()"><i class="ph ph-arrow-clockwise" aria-hidden="true"></i> Update from source</button>{{end}}
  {{end}}
  <hr>
  <button type="button" id="pip-hide"><i class="ph ph-caret-right" aria-hidden="true"></i> Hide controls</button>
</div>
{{/* What is left of the controls when they are put away: a tab on the side
     edge, always visible, that brings them back on a click or a drag. */}}
<button type="button" class="pip-tab" id="pip-tab" aria-label="Show artifact controls" hidden><i class="ph ph-caret-right" aria-hidden="true"></i><span class="pip-tab-label">{{.Title}}</span></button>
{{/* Moving or hiding the controls is announced to screen readers and shown
     nowhere: the visitor who dragged them can already see where they went. */}}
<div class="sr-only" id="pip-announce" role="status" aria-live="polite"></div>

</header>{{end}}
